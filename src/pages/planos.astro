---
import Base from '../layouts/Base.astro';
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import AnchorNav from '../components/ui/AnchorNav.astro';
import PricingPlans from '../components/ui/PricingPlans.astro';
import AIAddons from '../components/ui/AIAddons.astro';
import PricingSimulator from '../components/ui/PricingSimulator.astro';
import ComparisonTable from '../components/ui/ComparisonTable.astro';
import DotGrid from '../components/ui/DotGrid.astro';
---

<Base
  title="Planos e Preços — Voe CRM"
  description="Conheça os planos da Voe: Starter, Growth, Scale e Enterprise. CRM com WhatsApp nativo, automações e IA. Anual com 15% de desconto."
>
  <Header />
  <AnchorNav />

  <!-- HERO PLANOS -->
  <section class="planos-hero">
    <div class="container">
      <div class="eyebrow" data-animate="fade-up">Planos Voe</div>
      <h1 class="planos-hero-title" data-animate="fade-up" data-delay="0.1">Escolha o plano <em>ideal</em></h1>
      <p class="planos-hero-sub" data-animate="fade-up" data-delay="0.2">O plano certo para cada momento da sua operação.</p>
    </div>
  </section>

  <!-- PRICING PLANS -->
  <PricingPlans />

  <!-- AI ADD-ONS -->
  <AIAddons />

  <!-- SETUP -->
  <section class="setup-section" id="setup">
    <div class="container">
      <div class="eyebrow" data-animate="fade-up">Setup e implementação</div>
      <h2 class="section-title" data-animate="fade-up" data-delay="0.1">Você não migra <em>sozinho.</em></h2>
      <p class="section-sub" data-animate="fade-up" data-delay="0.2">O setup é cobrado uma única vez no início do contrato. Um especialista da Voe conduz cada etapa junto com a sua equipe, do zero até o time operando dentro do CRM.</p>

      <div class="setup-includes" data-animate="fade-up" data-delay="0.3">
        <span class="setup-pill">Importação da base existente</span>
        <span class="setup-pill">Configuração do funil e etapas</span>
        <span class="setup-pill">Configuração de origens e motivos de perda</span>
        <span class="setup-pill">Configuração de produtos e serviços</span>
        <span class="setup-pill">Conexão do número WhatsApp</span>
        <span class="setup-pill">Treinamento da equipe</span>
      </div>

      <div class="setup-grid" data-animate="fade-up" data-delay="0.4">
        <div class="setup-card">
          <div class="setup-plan">Starter</div>
          <div class="setup-sub">Pagamento único na contratação</div>
          <div class="setup-price">R$ 990 <span>único</span></div>
        </div>
        <div class="setup-card">
          <div class="setup-plan">Growth</div>
          <div class="setup-sub">Pagamento único na contratação</div>
          <div class="setup-price">R$ 1.390 <span>único</span></div>
        </div>
        <div class="setup-card">
          <div class="setup-plan">Scale</div>
          <div class="setup-sub">Pagamento único na contratação</div>
          <div class="setup-price">R$ 1.990 <span>único</span></div>
        </div>
        <div class="setup-card">
          <div class="setup-plan">Enterprise</div>
          <div class="setup-sub">Pagamento único na contratação</div>
          <div class="setup-price">Sob consulta</div>
        </div>
        <div class="setup-card">
          <div class="setup-plan">Voe SDR <span class="setup-badge">Opcional IA</span></div>
          <div class="setup-sub">Pagamento único na contratação</div>
          <div class="setup-price">R$ 2.490 <span>único</span></div>
        </div>
        <div class="setup-card">
          <div class="setup-plan">Voe CRM Inteligente <span class="setup-badge">Opcional IA</span></div>
          <div class="setup-sub">Ativação conduzida pelo time Voe</div>
          <div class="setup-price">Sem cobrança</div>
        </div>
      </div>
    </div>
  </section>

  <!-- SIMULADOR -->
  <PricingSimulator />

  <!-- COMPARATIVO -->
  <ComparisonTable />

  <!-- POLÍTICAS -->
  <section class="policies-section" id="politicas">
    <div class="container">
      <div class="eyebrow" data-animate="fade-up">Políticas</div>
      <h2 class="section-title" data-animate="fade-up" data-delay="0.1">Transparência e <em>segurança</em></h2>
      <p class="section-sub" data-animate="fade-up" data-delay="0.2">Tudo que você precisa saber sobre contrato, preço, mensageria e proteção de dados.</p>

      <div class="policies-grid" data-animate="fade-up" data-delay="0.3">
        <div class="policy-card">
          <h3>Mensageria Meta</h3>
          <p>Custos de mensagens do WhatsApp repassados ao custo exato da Meta, sem margem. O cliente conecta o número na própria conta Meta Business com o próprio cartão.</p>
          <ul>
            <li>Mensagens de serviço iniciadas pelo cliente: <strong>gratuitas</strong></li>
            <li>Template utilidade dentro da janela 24h: <strong>gratuito</strong></li>
            <li>Template marketing fora da janela: <strong>~R$ 0,30 a R$ 0,40/msg</strong></li>
            <li>Janela gratuita de 72h para anúncios Click-to-Chat</li>
          </ul>
        </div>
        <div class="policy-card">
          <h3>Reajuste e proteção de preço</h3>
          <p>Tabela de preços pública. Clientes ativos mantêm o valor da assinatura vigente por no mínimo 12 meses a partir da data de contratação em caso de reajuste.</p>
          <p>Para os adicionais de IA, os preços estão sujeitos a revisão nos primeiros 90 dias pós-lançamento. Quem contratar durante esse período mantém o valor original por no mínimo 12 meses.</p>
        </div>
        <div class="policy-card">
          <h3>Contrato</h3>
          <p>Plano mensal sem fidelidade — você cancela quando quiser. Plano anual com compromisso de 12 meses em troca do desconto de 15%.</p>
        </div>
        <div class="policy-card">
          <h3>LGPD e segurança</h3>
          <p>A Voe opera em conformidade com a LGPD. Dados criptografados em trânsito e em repouso. Acesso restrito por perfil de usuário. DPO designado para contato do titular.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="cta-final">
    <DotGrid />
    <div class="container" style="position:relative;z-index:1;">
      <h2 data-animate="fade-up">Pronto para ver<br/><em>na prática</em>?</h2>
      <p data-animate="fade-up" data-delay="0.1">Agende uma demonstração com o time da Voe. Mostramos o sistema funcionando, tiramos dúvidas na hora e você decide com calma.</p>
      <div class="cta-row" data-animate="fade-up" data-delay="0.2">
        <a href="https://wa.me/5511999803580" target="_blank" rel="noopener" class="btn btn-primary btn-lg" data-cta="planos-cta-demo">
          Agendar demonstração <span class="btn-arrow">→</span>
        </a>
        <a href="https://wa.me/5511999803580" target="_blank" rel="noopener" class="btn btn-ghost btn-lg" data-cta="planos-cta-whatsapp">
          Fale com a gente no WhatsApp
        </a>
      </div>
    </div>
  </section>

  <Footer />

  <div class="scroll-progress" id="scrollProgress"></div>

  <script>
    import { initSmoothScroll } from '../scripts/smooth-scroll';
    import { initScrollAnimations, initScrollDepthTracking, initCTATracking } from '../scripts/animations';

    function init() {
      initSmoothScroll();
      initScrollAnimations();
      initScrollDepthTracking();
      initCTATracking();

      const bar = document.getElementById('scrollProgress');
      if (bar) {
        window.addEventListener('scroll', () => {
          const h = document.documentElement.scrollHeight - window.innerHeight;
          if (h > 0) bar.style.width = (window.scrollY / h * 100) + '%';
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</Base>

<style>
  .planos-hero {
    padding: 140px 0 40px;
    background:
      radial-gradient(900px 500px at 78% -10%, rgba(0, 197, 180, 0.18), transparent 60%),
      linear-gradient(180deg, #1f3046 0%, #243345 50%, #2a3b50 100%);
    color: var(--off-white);
  }

  .planos-hero-title {
    font-family: var(--font-display);
    font-size: clamp(40px, 6vw, 80px);
    line-height: 1.0;
    letter-spacing: -0.04em;
    font-weight: 600;
    color: #fff;
    margin-bottom: 18px;
  }

  .planos-hero-title em {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--turquesa);
  }

  .planos-hero-sub {
    font-size: 19px;
    color: rgba(237,239,234,0.72);
    max-width: 560px;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--carvao-light);
    margin-bottom: 18px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .eyebrow::before {
    content: "";
    width: 16px;
    height: 1px;
    background: var(--turquesa);
  }

  .planos-hero .eyebrow {
    color: rgba(237,239,234,0.6);
  }

  .section-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(34px, 4.4vw, 56px);
    line-height: 1.04;
    letter-spacing: -0.035em;
    color: var(--ardosia);
    max-width: 800px;
    text-wrap: balance;
  }

  .section-title em {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--turquesa);
  }

  .section-sub {
    font-size: 18px;
    color: var(--carvao-light);
    max-width: 620px;
    margin-top: 18px;
    line-height: 1.5;
  }

  /* SETUP */
  .setup-section {
    background: var(--off-white);
    padding: 110px 0;
    scroll-margin-top: 80px;
  }

  .setup-includes {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 40px;
    margin-bottom: 40px;
    padding: 24px;
    background: var(--ardosia);
    border-radius: 12px;
  }

  .setup-pill {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 6px 14px;
    background: rgba(0,197,180,0.12);
    color: var(--turquesa);
    border: 1px solid rgba(0,197,180,0.30);
    border-radius: var(--radius-full);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .setup-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .setup-card {
    background: white;
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    padding: 24px;
  }

  .setup-plan {
    font-size: 16px;
    font-weight: 600;
    color: var(--ardosia);
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .setup-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--turquesa);
    padding: 2px 8px;
    background: rgba(0,197,180,0.10);
    border-radius: 3px;
    font-weight: 500;
  }

  .setup-sub {
    font-size: 12.5px;
    color: var(--carvao-light);
    margin-bottom: 12px;
  }

  .setup-price {
    font-size: 20px;
    font-weight: 600;
    color: var(--ardosia);
    letter-spacing: -0.02em;
  }

  .setup-price span {
    font-size: 13px;
    font-weight: 400;
    color: var(--carvao-light);
  }

  /* POLICIES */
  .policies-section {
    background: var(--off-white);
    padding: 110px 0;
    scroll-margin-top: 80px;
  }

  .policies-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 48px;
  }

  .policy-card {
    background: white;
    border: 1px solid var(--glass-border);
    border-radius: 14px;
    padding: 32px 28px;
  }

  .policy-card h3 {
    font-size: 18px;
    font-weight: 600;
    color: var(--ardosia);
    margin-bottom: 14px;
  }

  .policy-card p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--carvao-light);
    margin-bottom: 14px;
  }

  .policy-card p:last-child {
    margin-bottom: 0;
  }

  .policy-card ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 14px;
  }

  .policy-card li {
    font-size: 13px;
    color: var(--carvao-light);
    line-height: 1.5;
    padding-left: 12px;
    position: relative;
  }

  .policy-card li::before {
    content: "·";
    position: absolute;
    left: 0;
    color: var(--turquesa);
    font-weight: 700;
  }

  .policy-card li strong {
    color: var(--ardosia);
  }

  /* CTA FINAL */
  .cta-final {
    background: #F5F6F2;
    padding: 70px 0 140px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .cta-final h2 {
    font-size: clamp(48px, 7vw, 96px);
    line-height: 0.98;
    letter-spacing: -0.045em;
    font-weight: 600;
    color: var(--ardosia);
    margin-bottom: 28px;
  }

  .cta-final h2 em {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--turquesa);
  }

  .cta-final p {
    font-size: 19px;
    color: var(--carvao-light);
    max-width: 580px;
    margin: 0 auto 40px;
    line-height: 1.5;
  }

  .cta-row {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-arrow {
    transition: transform 0.15s;
  }

  .btn:hover .btn-arrow {
    transform: translateX(2px);
  }

  @media (max-width: 768px) {
    .setup-grid {
      grid-template-columns: 1fr;
    }

    .policies-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
