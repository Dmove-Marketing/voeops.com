---
// src/pages/suporte.astro
// Canal de suporte — acessível SEM login.
//
// Existe justamente para o pior chamado possível: "não consigo entrar".
// Quem não consegue autenticar não tem como pedir ajuda dentro do app.
//
// Site estático: o formulário em si não roda servidor nenhum aqui — ele
// envia os dados via fetch() pro backend do app.voeops.com (mesmo suporte
// nativo usado dentro do app), que localiza a conta pelo e-mail informado e
// abre o chamado de verdade. Nada disso passa por WhatsApp (ver
// docs/plano-suporte.md — decisão revista: suporte nativo em vez de decisão "a").
import Base from '../layouts/Base.astro';
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import { getArtigos, urlDoArtigo } from '../lib/ajuda';

const EMAIL_SUPORTE = 'contato@voeops.com';

// TODO(bruno): confirmar antes de publicar.
const HORARIO = 'Segunda a sexta, das 9h às 18h';
const SLA = 'Respondemos em até 4 horas úteis';

// Backend onde o chamado é de fato criado. Em dev, o Next local; em
// produção, o app real. Pode ser sobrescrito por env var se precisar.
const APP_URL =
  import.meta.env.PUBLIC_APP_URL ||
  (import.meta.env.DEV ? 'http://localhost:3000' : 'https://app.voeops.com');

const artigos = await getArtigos();
const maisLidos = artigos.slice(0, 5);

const ASSUNTOS = [
  { valor: 'conexao-whatsapp', label: 'Problema na conexão do WhatsApp' },
  { valor: 'envio-mensagem', label: 'Mensagem não enviada ou não recebida' },
  { valor: 'acesso', label: 'Não consigo entrar na minha conta' },
  { valor: 'billing', label: 'Plano, cobrança ou nota fiscal' },
  { valor: 'bug', label: 'Algo não está funcionando como deveria' },
  { valor: 'duvida-uso', label: 'Dúvida de como usar a plataforma' },
  { valor: 'outro', label: 'Outro assunto' },
];
---

<Base
  title="Suporte — Voe"
  description="Fale com o suporte da Voe. Abrimos um chamado com o contexto da sua conta em mãos."
  canonical="https://voeops.com/suporte/"
>
  <Header />

  <section class="sup-hero">
    <div class="container">
      <div class="sup-hero-icone" data-animate="scale-up" aria-hidden="true">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 11h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-5Zm0 0a9 9 0 1 1 18 0m0 0v5a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3Z"/>
          <path d="M21 16v2a4 4 0 0 1-4 4h-5"/>
        </svg>
      </div>
      <div class="eyebrow eyebrow--turquesa" data-animate="fade-up">Suporte</div>
      <h1 class="sup-titulo" data-animate="fade-up" data-delay="0.1">
        Fale com <em>a gente</em>
      </h1>
      <p class="sup-sub" data-animate="fade-up" data-delay="0.2">
        {HORARIO}. {SLA}.
      </p>
    </div>
  </section>

  <section class="sup-section">
    <div class="container sup-grid">

      <!-- Coluna principal: formulário -->
      <div class="sup-form-col" data-animate="fade-up">
        <div class="sup-card">
          <h2 class="sup-card-titulo">Conte o que aconteceu</h2>
          <p class="sup-card-sub">
            Quanto mais específico, mais rápido a gente resolve.
          </p>

          <form id="sup-form" novalidate>
            <div class="form-group">
              <label for="sup-nome"><svg class="sup-label-icone" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>Seu nome</label>
              <input class="form-input" type="text" id="sup-nome" name="nome" required autocomplete="name" />
            </div>

            <div class="form-group">
              <label for="sup-email"><svg class="sup-label-icone" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>E-mail da sua conta Voe</label>
              <input class="form-input" type="email" id="sup-email" name="email" required autocomplete="email" />
              <small class="sup-hint">É por ele que localizamos sua conta.</small>
            </div>

            <div class="form-group">
              <label for="sup-assunto"><svg class="sup-label-icone" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41 11 3.83A2 2 0 0 0 9.59 3.24L3 3v6.59a2 2 0 0 0 .59 1.41l9.58 9.58a2 2 0 0 0 2.83 0l4.59-4.59a2 2 0 0 0 0-2.83Z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg>Qual o assunto?</label>
              <select class="form-input" id="sup-assunto" name="assunto" required>
                <option value="">Selecione…</option>
                {ASSUNTOS.map((a) => (
                  <option value={a.valor}>{a.label}</option>
                ))}
              </select>
            </div>

            <div class="form-group">
              <label for="sup-descricao"><svg class="sup-label-icone" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>O que está acontecendo?</label>
              <textarea
                class="form-input"
                id="sup-descricao"
                name="descricao"
                rows="5"
                required
                placeholder="Descreva o problema. Se puder, diga o que você estava fazendo quando aconteceu."
              ></textarea>
            </div>

            <div class="sup-reasseguro">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/></svg>
              <span>Assim que localizarmos sua conta, o time já recebe o chamado com o contexto dela (plano, workspace) em mãos — sem "me manda print".</span>
            </div>

            <p class="sup-erro" id="sup-erro" hidden></p>

            <button type="submit" class="btn btn-primary btn-lg sup-submit">
              <span class="btn-text">Abrir chamado</span>
              <span class="btn-loading" style="display:none;">
                <svg class="spinner" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" />
                </svg>
                Enviando...
              </span>
            </button>

            <p class="sup-nota">
              Abrimos um chamado direto com o nosso time. {SLA}.
            </p>
          </form>

          <!-- Conflito: já existe um chamado aberto sobre o mesmo assunto.
               Fica dentro do mesmo card, no lugar do formulário — sem
               overlay, sem fundo escurecido, sem cobrir o resto da página. -->
          <div id="sup-conflito-inline" class="sup-conflito-inline" hidden>
            <div class="sup-conflito-icone" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-5Zm0 0a9 9 0 1 1 18 0m0 0v5a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3Z"/><path d="M21 16v2a4 4 0 0 1-4 4h-5"/></svg>
            </div>
            <h2 class="sup-conflito-titulo">Você já tem um chamado em aberto</h2>
            <p class="sup-conflito-sub">Sobre "<span id="sup-conflito-assunto"></span>". O que você quer fazer?</p>

            <div class="sup-conflito-acoes">
              <button type="button" id="sup-conflito-ver" class="btn btn-primary sup-conflito-btn">Ver esse chamado</button>
              <button type="button" id="sup-conflito-novo" class="sup-conflito-btn sup-conflito-btn--secundario">Criar novo chamado mesmo assim</button>
              <button type="button" id="sup-conflito-cancelar" class="sup-conflito-btn sup-conflito-btn--texto">Voltar e revisar</button>
            </div>
          </div>
        </div>

        <div class="sup-alternativo">
          Prefere e-mail? Escreva para
          <a href={`mailto:${EMAIL_SUPORTE}`}>{EMAIL_SUPORTE}</a>.
        </div>
      </div>

      <!-- Coluna lateral: deflexão -->
      <aside class="sup-aside" data-animate="fade-up" data-delay="0.1">
        <div class="sup-card sup-card--sutil">
          <div class="sup-aside-header">
            <span class="sup-aside-icone sup-aside-icone--turquesa">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6M10 22h4M15 2A6 6 0 0 0 6 8c0 3.5 2 4.5 3 6h6c1-1.5 3-2.5 3-6a6 6 0 0 0-3-6Z"/></svg>
            </span>
            <h2 class="sup-aside-titulo">Talvez resolva agora</h2>
          </div>
          <p class="sup-aside-sub">
            Boa parte das dúvidas já tem resposta pronta na Central.
          </p>
          {maisLidos.length > 0 ? (
            <ul class="sup-links">
              {maisLidos.map((artigo) => (
                <li>
                  <a href={urlDoArtigo(artigo)}>
                    <span>{artigo.data.titulo}</span>
                    <svg class="sup-link-seta" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="sup-aside-sub">Central em construção.</p>
          )}
          <a href="/ajuda" class="sup-aside-link">Ver a Central de Ajuda <span>→</span></a>
        </div>
      </aside>

    </div>
  </section>

  <Footer />

  <script is:inline define:vars={{ APP_URL }}>
    (function () {
      const form = document.getElementById('sup-form');
      const erro = document.getElementById('sup-erro');
      if (!form) return;

      const submitBtn = form.querySelector('.sup-submit');
      const btnText = form.querySelector('.btn-text');
      const btnLoading = form.querySelector('.btn-loading');

      const conflito = document.getElementById('sup-conflito-inline');
      const conflitoAssunto = document.getElementById('sup-conflito-assunto');
      const conflitoVerBtn = document.getElementById('sup-conflito-ver');
      const conflitoNovoBtn = document.getElementById('sup-conflito-novo');
      const conflitoCancelarBtn = document.getElementById('sup-conflito-cancelar');

      const setCarregando = (carregando) => {
        submitBtn.disabled = carregando;
        if (btnText) btnText.style.display = carregando ? 'none' : 'inline';
        if (btnLoading) btnLoading.style.display = carregando ? 'inline-flex' : 'none';
      };

      function mostrarSucesso() {
        form.innerHTML =
          '<div class="sup-sucesso">' +
            '<div class="sup-sucesso-icone">' +
              '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>' +
            '</div>' +
            '<p class="sup-sucesso-titulo">Chamado aberto!</p>' +
            '<p class="sup-sucesso-texto">Acompanhe a resposta por aqui mesmo, pelo balão de suporte no canto da tela — ou quando você entrar na Voe, a conversa já vai estar te esperando lá.</p>' +
          '</div>';
      }

      // Grava a referência pro widget de acompanhamento (canto inferior
      // direito) aparecer com esse chamado, e abre o painel dele — sem isso
      // o cliente não tem como ver a conversa (não existe mais busca por
      // e-mail no widget).
      function acompanharChamado(ticketId, email) {
        try {
          localStorage.setItem('voe_sup_status_ticket', JSON.stringify({ ticketId, email }));
        } catch (e) { /* ignora */ }
        window.dispatchEvent(new CustomEvent('voe:chamado-aberto'));
      }

      function abrirPainelWidget() {
        setTimeout(function () {
          var btn = document.getElementById('voe-sup-status-btn');
          if (btn && !btn.hidden) btn.click();
        }, 250);
      }

      // Sem overlay: o conflito troca de lugar com o formulário dentro do
      // mesmo card (igual à tela de sucesso) — nunca cobre o resto da
      // página, então não tem como "travar a tela" nem por engano.
      function fecharConflito() {
        if (!conflito) return;
        conflito.hidden = true;
        form.hidden = false;
      }

      function abrirConflito(ticketId, subject, dados) {
        if (!conflito) return;
        if (conflitoAssunto) conflitoAssunto.textContent = subject || 'seu chamado';
        form.hidden = true;
        conflito.hidden = false;

        conflitoVerBtn.onclick = function () {
          acompanharChamado(ticketId, dados.email);
          fecharConflito();
          abrirPainelWidget();
        };
        conflitoNovoBtn.onclick = function () {
          fecharConflito();
          enviarChamado(Object.assign({}, dados, { forcar: true }));
        };
        conflitoCancelarBtn.onclick = fecharConflito;
      }

      async function enviarChamado(dados) {
        erro.hidden = true;
        setCarregando(true);
        try {
          const res = await fetch(APP_URL + '/api/public/support-ticket', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(dados),
          });
          const json = await res.json().catch(() => ({}));

          if (res.ok && json.ok) {
            if (window.dataLayer) {
              window.dataLayer.push({ event: 'suporte_chamado', assunto: dados.assunto });
            }
            if (json.ticketId) acompanharChamado(json.ticketId, dados.email);
            mostrarSucesso();
            return;
          }

          if (res.status === 404 && json.error === 'conta_nao_encontrada') {
            erro.textContent = 'Não encontramos uma conta com esse e-mail. Confira se digitou certo, ou escreva para contato@voeops.com.';
            erro.hidden = false;
            setCarregando(false);
          } else if (res.status === 409 && json.error === 'tema_duplicado') {
            setCarregando(false);
            abrirConflito(json.ticketId, json.subject, dados);
          } else {
            erro.textContent = 'Tivemos um problema por aqui e não conseguimos abrir seu chamado agora. Tente de novo em alguns instantes — se continuar assim, escreva direto para contato@voeops.com que a gente resolve por lá.';
            erro.hidden = false;
            setCarregando(false);
          }
        } catch (err) {
          erro.textContent = 'Falha de conexão. Tente novamente.';
          erro.hidden = false;
          setCarregando(false);
        }
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();

        const nome = form.nome.value.trim();
        const email = form.email.value.trim();
        const assunto = form.assunto.value;
        const descricao = form.descricao.value.trim();

        if (!nome || !email || !assunto || !descricao) {
          erro.textContent = 'Preencha todos os campos para continuar.';
          erro.hidden = false;
          return;
        }
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          erro.textContent = 'Confira o e-mail digitado.';
          erro.hidden = false;
          return;
        }

        enviarChamado({ nome, email, assunto, descricao });
      });
    })();
  </script>
</Base>

<style is:global>
  .sup-hero { padding: 140px 0 40px; text-align: center; }

  .sup-hero-icone {
    width: 60px;
    height: 60px;
    margin: 0 auto var(--space-md);
    border-radius: 50%;
    background: var(--gradient-primary);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-glow);
  }

  .sup-titulo {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-sm);
  }

  .sup-titulo em {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-weight: 400;
    color: var(--turquesa);
  }

  .sup-sub { color: var(--text-secondary); font-size: 1.05rem; }

  .sup-section { padding: var(--space-xl) 0 var(--space-4xl); }

  .sup-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: var(--space-2xl);
    align-items: start;
  }

  .sup-card {
    background: var(--bg-card);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    padding: var(--space-2xl);
    transition: box-shadow 0.3s ease;
  }

  .sup-form-col .sup-card:hover { box-shadow: 0 8px 32px rgba(0, 0, 0, 0.06); }

  .sup-card--sutil {
    background: var(--bg-secondary);
    padding: var(--space-xl);
  }

  .sup-card + .sup-card { margin-top: var(--space-lg); }

  .sup-card-titulo {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 4px;
  }

  .sup-card-sub {
    color: var(--text-secondary);
    font-size: 0.925rem;
    margin-bottom: var(--space-xl);
  }

  .sup-aside-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }

  .sup-aside-icone {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sup-aside-icone--turquesa { background: var(--turquesa-10); color: var(--turquesa); }

  .sup-form-col .form-group { margin-bottom: var(--space-lg); }

  .sup-form-col label {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .sup-label-icone { color: var(--turquesa); flex-shrink: 0; }

  .sup-form-col textarea.form-input {
    resize: vertical;
    min-height: 120px;
    font-family: var(--font-body);
  }

  .sup-form-col select.form-input {
    font-family: var(--font-body);
    cursor: pointer;
  }

  .sup-form-col .form-input {
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .sup-form-col .form-input:focus {
    border-color: var(--turquesa);
    box-shadow: 0 0 0 3px var(--turquesa-10);
    outline: none;
  }

  .sup-hint {
    display: block;
    margin-top: 5px;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .sup-reasseguro {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 12px 14px;
    margin-bottom: var(--space-lg);
    border-radius: var(--radius-sm);
    background: var(--turquesa-10);
    color: var(--text-secondary);
    font-size: 0.8rem;
    line-height: 1.5;
  }
  .sup-reasseguro svg { color: var(--turquesa); flex-shrink: 0; margin-top: 1px; }

  .sup-erro {
    padding: 10px 14px;
    margin-bottom: var(--space-md);
    font-size: 0.875rem;
    color: var(--terracotta);
    background: var(--terracotta-10);
    border-radius: var(--radius-sm);
  }

  .sup-submit { width: 100%; justify-content: center; }

  .sup-submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none !important;
  }

  .btn-loading {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .spinner { animation: spin 1s linear infinite; }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .sup-sucesso {
    text-align: center;
    padding: var(--space-xl) 0;
  }

  .sup-sucesso-icone {
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--space-md);
    background: var(--gradient-primary);
    border-radius: 50%;
    color: white;
    box-shadow: var(--shadow-glow);
    animation: sup-badge-in 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes sup-badge-in {
    0% { transform: scale(0.5); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }

  .sup-sucesso-titulo {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .sup-sucesso-texto {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .sup-nota {
    margin-top: var(--space-md);
    font-size: 0.8rem;
    color: var(--text-muted);
    text-align: center;
    line-height: 1.5;
  }

  .sup-alternativo {
    margin-top: var(--space-lg);
    text-align: center;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .sup-alternativo a { color: var(--turquesa); }

  .sup-aside-titulo {
    font-size: 1rem;
    font-weight: 600;
  }

  .sup-aside-sub {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: var(--space-md);
  }

  .sup-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: var(--space-md);
  }

  .sup-links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 8px;
    margin: 0 -8px;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    color: var(--text-secondary);
    text-decoration: none;
    line-height: 1.45;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .sup-link-seta {
    flex-shrink: 0;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .sup-links a:hover {
    color: var(--turquesa);
