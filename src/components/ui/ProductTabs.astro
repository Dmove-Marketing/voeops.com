---
// src/components/ui/ProductTabs.astro
// Tabbed product showcase with 9 feature tabs.
import DotGrid from './DotGrid.astro';
---

<section class="tabs-section" id="produto">
  <DotGrid />
  <div class="container-wide">
    <div class="tabs-head">
      <div>
        <div class="eyebrow eyebrow--terracotta">Produto em ação</div>
        <h2 class="section-title">Explore os principais <em>recursos</em></h2>
        <p class="section-sub" id="tabSub">Inbox unificado de WhatsApp e Instagram Direct.</p>
      </div>
    </div>
    
    <div class="tabs-wrapper">
      <div class="tabs-bar" id="tabsBar">
        <button class="tab-btn active" data-tab="conversas">Conversas</button>
        <button class="tab-btn" data-tab="negociacoes">Negociações</button>
        <button class="tab-btn" data-tab="oportunidade">Oportunidade</button>
        <button class="tab-btn" data-tab="atividades">Atividades</button>
        <button class="tab-btn" data-tab="whatsapp">WhatsApp agendado</button>
        <button class="tab-btn" data-tab="agenda">Agenda</button>
        <button class="tab-btn" data-tab="audiencias">Audiências</button>
        <button class="tab-btn" data-tab="campanhas">Campanhas</button>
        <button class="tab-btn" data-tab="automacoes">Automações</button>
      </div>
      <div class="scroll-hint" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </div>
    </div>
    
    <div class="tabs-body">
      <div class="tab-screenshot">
        <div id="tabScreen" class="mock-host">
          <img
            id="tabImg"
            src="/images/tabs/tab-conversas.webp"
            srcset="/images/tabs/tab-conversas-480w.webp 480w, /images/tabs/tab-conversas-900w.webp 900w, /images/tabs/tab-conversas.webp 1500w"
            sizes="(max-width: 600px) calc(100vw - 48px), (max-width: 1024px) calc(90vw - 48px), 1200px"
            alt="Conversas"
            class="tab-img"
            width="1500"
            height="955"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    const tabData = {
      conversas: {
        title: "Conversas",
        lead: "Inbox unificado de WhatsApp e Instagram Direct.",
        img: "/images/tabs/tab-conversas.webp",
      },
      negociacoes: {
        title: "Negociações",
        lead: "Funil visual em Kanban ou lista, múltiplos funis simultâneos.",
        img: "/images/tabs/tab-negociacoes.webp",
      },
      oportunidade: {
        title: "Oportunidade",
        lead: "Tudo que o vendedor precisa, sem sair da tela.",
        img: "/images/tabs/tab-oportunidade.webp",
      },
      atividades: {
        title: "Atividades",
        lead: "Lista centralizada de todas as atividades do time.",
        img: "/images/tabs/tab-atividades.webp",
      },
      whatsapp: {
        title: "WhatsApp agendado",
        lead: "Agende envio de mensagem para data e hora definidos.",
        img: "/images/tabs/tab-whatsapp.webp",
      },
      agenda: {
        title: "Agenda",
        lead: "Calendario visual sincronizado com o CRM.",
        img: "/images/tabs/tab-agenda.webp",
      },
      audiencias: {
        title: "Audiências",
        lead: "Segmentação avancada de contatos e negociações.",
        img: "/images/tabs/tab-audiencias.webp",
      },
      campanhas: {
        title: "Campanhas",
        lead: "Disparo em massa de WhatsApp e e-mail.",
        img: "/images/tabs/tab-campanhas.webp",
      },
      automacoes: {
        title: "Automações",
        lead: "Fluxos disparados por gatilhos do sistema.",
        img: "/images/tabs/tab-automacoes.webp",
      },
    };

    const section = document.getElementById("produto");
    if (!section) return;

    const tabs = section.querySelectorAll(".tab-btn");
    const subtitle = document.getElementById("tabSub");
    const tabImg = document.getElementById("tabImg") as HTMLImageElement;

    tabs.forEach(function (tab) {
      tab.addEventListener("click", function () {
        const key = tab.getAttribute("data-tab");
        const data = tabData[key];
        if (!data) return;

        tabs.forEach(function (t) {
          t.classList.remove("active");
        });
        tab.classList.add("active");

        if (subtitle) subtitle.textContent = data.lead;
        if (tabImg) {
          tabImg.srcset = "";
          tabImg.src = data.img;
          tabImg.alt = data.title;
        }

        // Ensure the clicked tab smoothly scrolls into the center of the viewport
        tab.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
      });
    });

    const tabsBar = document.getElementById("tabsBar");
    const scrollHint = document.querySelector(".scroll-hint");
    if (tabsBar && scrollHint) {
      tabsBar.addEventListener("scroll", function() {
        if (tabsBar.scrollLeft > 20) {
          (scrollHint as HTMLElement).style.opacity = "0";
        } else {
          (scrollHint as HTMLElement).style.opacity = "1";
        }
      });
    }
  })();
</script>

<style>
  .tabs-section {
    --line: rgba(0,0,0,0.06);
  }

  .tabs-section { 
    background: var(--bg-secondary); 
    border-top: 1px solid var(--line); 
    border-bottom: 0; 
    position: relative; 
    overflow: hidden; 
    padding: 110px 0;
  }

  .container-wide {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 5%;
  }

  .tabs-section > .container-wide { position: relative; z-index: 1; }

  .eyebrow::before { background: var(--turquesa); }

  .tabs-head { 
    display: flex; 
    justify-content: space-between; 
    align-items: flex-end; 
    flex-wrap: wrap; 
    gap: 28px; 
    margin-bottom: 50px; 
  }

  #tabSub {
    min-height: 3em; /* Ensures enough space for two lines, preventing layout shift */
  }

  .tabs-wrapper {
    position: relative;
    margin-bottom: 32px;
  }

  .scroll-hint {
    display: none;
  }

  .tabs-bar { 
    display: flex; 
    flex-wrap: wrap; 
    gap: 4px; 
    padding: 6px; 
    background: white; 
    border: 1px solid var(--line); 
    border-radius: 10px; 
  }
  
  .tabs-bar .tab-btn { 
    flex: 1 1 0; 
    min-width: 0; 
    text-align: center; 
    justify-content: center; 
  }

  .tab-btn {
    padding: 9px 14px; 
    font-size: 0.844rem; 
    color: var(--text-secondary); 
    border-radius: 6px;
    transition: all 0.15s;
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: inherit;
  }
  .tab-btn:hover { color: var(--carvao); }
  .tab-btn.active { background: var(--ardosia); color: white; }
  
  .tabs-body {
    background: #fff;
    border: 1px solid rgba(0,197,180,0.18);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    padding: 16px;
    box-shadow: 0 4px 24px rgba(48,69,91,0.06), 0 1px 4px rgba(48,69,91,0.04);
  }

  .tab-screenshot {
    aspect-ratio: 1500 / 955;
    width: 100%;
    background: #f5f6f8;
    border-radius: 8px;
    border: 1px solid var(--line);
    overflow: hidden;
  }

  .mock-host {
    width: 100%;
    height: 100%;
  }

  .tab-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }



  /* Dot Grid styles */
  .dot-grid-container {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  .dot-grid-container canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }
  .dot-grid-glow-static {
    position: absolute;
    top: 15%;
    left: 50%;
    width: 600px;
    height: 400px;
    background: radial-gradient(circle, rgba(0, 197, 180, 0.04) 0%, transparent 65%);
    filter: blur(50px);
    pointer-events: none;
    z-index: 0;
    transform: translateX(-50%);
  }

  @media (max-width: 768px) {
    .tabs-section {
      padding: 60px 0;
    }
    .tabs-wrapper::after {
      content: '';
      position: absolute;
      top: 1px;
      right: 1px;
      bottom: 1px;
      width: 60px;
      background: linear-gradient(to right, rgba(255,255,255,0), #ffffff 90%);
      pointer-events: none;
      border-radius: 0 9px 9px 0;
      z-index: 2;
    }
    
    .tabs-bar {
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      justify-content: flex-start;
      border-radius: 10px;
      padding-right: 40px; /* Extra padding so last item clears the gradient */
      scrollbar-width: none; /* Firefox */
      -ms-overflow-style: none; /* IE/Edge */
    }
    .tabs-bar::-webkit-scrollbar {
      display: none; /* Chrome, Safari, Opera */
    }
    .tabs-bar .tab-btn {
      flex: 0 0 auto;
    }
    
    .scroll-hint {
      display: flex;
      position: absolute;
      right: 8px;
      top: 50%;
      transform: translateY(-50%);
      width: 28px;
      height: 28px;
      align-items: center;
      justify-content: center;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 50%;
      color: var(--text-secondary);
      z-index: 3;
      pointer-events: none;
      box-shadow: 0 2px 6px rgba(0,0,0,0.08);
      animation: bounceRight 1.5s infinite;
      transition: opacity 0.3s ease;
    }
    @keyframes bounceRight {
      0%, 100% { transform: translate(0, -50%); }
      50% { transform: translate(4px, -50%); }
    }
  }
</style>
