---
// src/components/ui/ProductTabs.astro
// Tabbed product showcase with 9 feature tabs.
---

<section class="tabs-section" id="produto">
  <div class="dot-grid-container">
    <div class="dot-grid-glow-static"></div>
    <canvas class="dot-grid-canvas"></canvas>
  </div>
  <div class="container-wide">
    <div class="tabs-head">
      <div>
        <div class="eyebrow eyebrow--terracotta">Produto em ação</div>
        <h2 class="section-title">Explore os principais <em>recursos</em></h2>
        <p class="section-sub" id="tabSub">Inbox unificado de WhatsApp e Instagram Direct.</p>
      </div>
    </div>
    
    <div class="tabs-wrapper">
      <div class="tabs-bar" id="tabsBar">
        <button class="tab-btn active" data-tab="conversas">Conversas</button>
        <button class="tab-btn" data-tab="negociacoes">Negociações</button>
        <button class="tab-btn" data-tab="oportunidade">Oportunidade</button>
        <button class="tab-btn" data-tab="atividades">Atividades</button>
        <button class="tab-btn" data-tab="whatsapp">WhatsApp agendado</button>
        <button class="tab-btn" data-tab="agenda">Agenda</button>
        <button class="tab-btn" data-tab="audiencias">Audiências</button>
        <button class="tab-btn" data-tab="campanhas">Campanhas</button>
        <button class="tab-btn" data-tab="automacoes">Automações</button>
      </div>
      <div class="scroll-hint" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </div>
    </div>
    
    <div class="tabs-body">
      <div class="tab-screenshot">
        <div id="tabScreen" class="mock-host">
          <span class="mock-placeholder">Screenshot em breve</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    const tabData = {
      conversas: {
        title: "Conversas",
        lead: "Inbox unificado de WhatsApp e Instagram Direct.",
      },
      negociacoes: {
        title: "Negociações",
        lead: "Funil visual em Kanban ou lista, múltiplos funis simultâneos.",
      },
      oportunidade: {
        title: "Oportunidade",
        lead: "Tudo que o vendedor precisa, sem sair da tela.",
      },
      atividades: {
        title: "Atividades",
        lead: "Lista centralizada de todas as atividades do time.",
      },
      whatsapp: {
        title: "WhatsApp agendado",
        lead: "Agende envio de mensagem para data e hora definidos.",
      },
      agenda: {
        title: "Agenda",
        lead: "Calendario visual sincronizado com o CRM.",
      },
      audiencias: {
        title: "Audiências",
        lead: "Segmentação avancada de contatos e negociações.",
      },
      campanhas: {
        title: "Campanhas",
        lead: "Disparo em massa de WhatsApp e e-mail.",
      },
      automacoes: {
        title: "Automações",
        lead: "Fluxos disparados por gatilhos do sistema.",
      },
    };

    const section = document.getElementById("produto");
    if (!section) return;

    const tabs = section.querySelectorAll(".tab-btn");
    const subtitle = document.getElementById("tabSub");

    tabs.forEach(function (tab) {
      tab.addEventListener("click", function () {
        const key = tab.getAttribute("data-tab");
        const data = tabData[key];
        if (!data) return;

        tabs.forEach(function (t) {
          t.classList.remove("active");
        });
        tab.classList.add("active");

        if (subtitle) subtitle.textContent = data.lead;
      });
    });

    const tabsBar = document.getElementById("tabsBar");
    const scrollHint = document.querySelector(".scroll-hint");
    if (tabsBar && scrollHint) {
      tabsBar.addEventListener("scroll", function() {
        if (tabsBar.scrollLeft > 20) {
          (scrollHint as HTMLElement).style.opacity = "0";
        } else {
          (scrollHint as HTMLElement).style.opacity = "1";
        }
      });
    }
  })();

  // Dot Grid Script
  (function() {
    const dpr = window.devicePixelRatio || 1;
    const SPACING = 32;
    const RADIUS = 1.2;
    const DOT_COLOR = 'rgba(48, 69, 91, 0.12)';
    const GLOW_COLOR = 'rgba(0, 197, 180, 0.15)'; // turquesa glow

    function attach(container) {
      const canvas = container.querySelector('.dot-grid-canvas') as HTMLCanvasElement;
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      
      const section = container.parentElement;
      if (!section) return;

      let mouse = { x: -9999, y: -9999 };
      let dots: Array<{x: number, y: number}> = [];
      let w = 0, h = 0;

      function resize() {
        const rect = container.getBoundingClientRect();
        w = rect.width; h = rect.height;
        canvas.width = w * dpr; canvas.height = h * dpr;
        ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
        buildDots();
      }
      function buildDots() {
        dots = [];
        const cols = Math.ceil(w / SPACING) + 1;
        const rows = Math.ceil(h / SPACING) + 1;
        const offX = (w - (cols - 1) * SPACING) / 2;
        const offY = (h - (rows - 1) * SPACING) / 2;

        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            dots.push({ x: offX + c * SPACING, y: offY + r * SPACING });
          }
        }
      }
      function draw() {
        ctx!.clearRect(0, 0, w, h);
        for (let i = 0; i < dots.length; i++) {
          const d = dots[i];
          const dx = mouse.x - d.x;
          const dy = mouse.y - d.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          // default dot
          ctx!.fillStyle = DOT_COLOR;
          ctx!.beginPath();
          ctx!.arc(d.x, d.y, RADIUS, 0, Math.PI * 2);
          ctx!.fill();

          // glow radius interaction
          const interactionRadius = 140;
          if (dist < interactionRadius) {
            const intensity = 1 - (dist / interactionRadius);
            ctx!.fillStyle = `rgba(0, 197, 180, ${intensity * 0.4})`; // pulse glow
            ctx!.beginPath();
            ctx!.arc(d.x, d.y, RADIUS * (1 + intensity * 1.5), 0, Math.PI * 2);
            ctx!.fill();
          }
        }
        requestAnimationFrame(draw);
      }

      window.addEventListener('resize', resize);
      section.addEventListener('mousemove', (e) => {
        const rect = container.getBoundingClientRect();
        mouse.x = (e as MouseEvent).clientX - rect.left;
        mouse.y = (e as MouseEvent).clientY - rect.top;
      });
      section.addEventListener('mouseleave', () => {
        mouse.x = -9999; mouse.y = -9999;
      });

      resize();
      draw();
    }
    
    document.querySelectorAll('.dot-grid-container').forEach(attach);
  })();
</script>

<style>
  .tabs-section {
    --line: rgba(0,0,0,0.06);
  }

  .tabs-section { 
    background: var(--bg-secondary); 
    border-top: 1px solid var(--line); 
    border-bottom: 0; 
    position: relative; 
    overflow: hidden; 
    padding: 110px 0;
  }

  .container-wide {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 5%;
  }

  .tabs-section > .container-wide { position: relative; z-index: 1; }

  .eyebrow::before { background: var(--turquesa); }

  .tabs-head { 
    display: flex; 
    justify-content: space-between; 
    align-items: flex-end; 
    flex-wrap: wrap; 
    gap: 28px; 
    margin-bottom: 50px; 
  }

  .tabs-wrapper {
    position: relative;
    margin-bottom: 32px;
  }

  .scroll-hint {
    display: none;
  }

  .tabs-bar { 
    display: flex; 
    flex-wrap: wrap; 
    gap: 4px; 
    padding: 6px; 
    background: white; 
    border: 1px solid var(--line); 
    border-radius: 10px; 
  }
  
  .tabs-bar .tab-btn { 
    flex: 1 1 0; 
    min-width: 0; 
    text-align: center; 
    justify-content: center; 
  }

  .tab-btn {
    padding: 9px 14px; 
    font-size: 0.844rem; 
    color: var(--text-secondary); 
    border-radius: 6px;
    transition: all 0.15s;
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: inherit;
  }
  .tab-btn:hover { color: var(--carvao); }
  .tab-btn.active { background: var(--ardosia); color: white; }
  
  .tabs-body {
    background: #fff; 
    border: 1px solid rgba(0,197,180,0.18);
    border-radius: 12px; 
    height: clamp(560px, 70vh, 760px);
    display: flex; 
    flex-direction: column;
    padding: 24px;
    box-shadow: 0 4px 24px rgba(48,69,91,0.06), 0 1px 4px rgba(48,69,91,0.04);
  }
  
  .tab-screenshot {
    flex: 1; 
    min-height: 0; 
    background: #fff; 
    border-radius: 8px; 
    border: 1px solid var(--line);
    overflow: hidden;
  }

  .mock-host { 
    width: 100%; 
    height: 100%; 
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mock-placeholder {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
    opacity: 0.6;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }



  /* Dot Grid styles */
  .dot-grid-container {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  .dot-grid-container canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }
  .dot-grid-glow-static {
    position: absolute;
    top: 15%;
    left: 50%;
    width: 600px;
    height: 400px;
    background: radial-gradient(circle, rgba(0, 197, 180, 0.04) 0%, transparent 65%);
    filter: blur(50px);
    pointer-events: none;
    z-index: 0;
    transform: translateX(-50%);
  }

  @media (max-width: 768px) {
    .tabs-section {
      padding: 60px 0;
    }
    .tabs-wrapper::after {
      content: '';
      position: absolute;
      top: 1px;
      right: 1px;
      bottom: 1px;
      width: 60px;
      background: linear-gradient(to right, rgba(255,255,255,0), #ffffff 90%);
      pointer-events: none;
      border-radius: 0 9px 9px 0;
      z-index: 2;
    }
    
    .tabs-bar {
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      justify-content: flex-start;
      border-radius: 10px;
      padding-right: 40px; /* Extra padding so last item clears the gradient */
      scrollbar-width: none; /* Firefox */
      -ms-overflow-style: none; /* IE/Edge */
    }
    .tabs-bar::-webkit-scrollbar {
      display: none; /* Chrome, Safari, Opera */
    }
    .tabs-bar .tab-btn {
      flex: 0 0 auto;
    }
    
    .scroll-hint {
      display: flex;
      position: absolute;
      right: 8px;
      top: 50%;
      transform: translateY(-50%);
      width: 28px;
      height: 28px;
      align-items: center;
      justify-content: center;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 50%;
      color: var(--text-secondary);
      z-index: 3;
      pointer-events: none;
      box-shadow: 0 2px 6px rgba(0,0,0,0.08);
      animation: bounceRight 1.5s infinite;
      transition: opacity 0.3s ease;
    }
    @keyframes bounceRight {
      0%, 100% { transform: translate(0, -50%); }
      50% { transform: translate(4px, -50%); }
    }
  }
</style>
