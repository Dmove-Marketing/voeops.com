---
// src/components/ui/AreasCarousel.astro
// Carousel by area (Atendimento, Vendas, Marketing, IA).
// Dark background section with glass-dark cards and vanilla JS carousel.

const AREAS = [
  {
    key: "atendimento",
    label: "Atendimento",
    slides: [
      { titleHtml: 'O melhor inbox de <em>WhatsApp</em> do mercado', desc: "Interface construída para quem faz atendimento comercial o dia inteiro no WhatsApp. Conversa em primeiro plano, contexto do lead ao lado.", img: "/images/tabs/atendimento-inbox.png" },
      { titleHtml: '<em>Contexto</em> completo do lead ao lado', desc: "Dados do contato, histórico da oportunidade, atividades pendentes e arquivos. Tudo visível sem sair da conversa.", img: "/images/tabs/atendimento-contexto.png" },
      { titleHtml: 'Transferência sem perder <em>histórico</em>', desc: "Passa o atendimento entre vendedores com todo o contexto. Quem recebe continua de onde parou.", img: "/images/tabs/atendimento-transferencia.png" },
      { titleHtml: 'Follow-up que <em>não esquece</em>', desc: "Agende envio de WhatsApp para data e hora definidos. Se o cliente responder antes, a Voe cancela o envio automaticamente.", img: "/images/tabs/atendimento-followup.png" },
    ],
  },
  {
    key: "vendas",
    label: "Vendas",
    slides: [
      { titleHtml: 'Funil com <em>visibilidade real</em>', desc: "Kanban ou lista, múltiplos funis, campos personalizados por funil, motivos de perda e de pausa. Tudo em uma tela.", img: "/images/tabs/vendas-funil.png" },
      { titleHtml: 'Oportunidade <em>completa</em>', desc: "Histórico com separação entre anotações e eventos. WhatsApp, atividades, arquivos e campos personalizados na mesma tela.", img: "/images/tabs/vendas-oportunidade.png" },
      { titleHtml: 'Atividades com <em>status</em> e prazos', desc: "Tarefas, ligações, e-mails, reuniões e visitas. Filtros por status: todas, hoje, atrasadas, agendadas, minhas.", img: "/images/tabs/vendas-atividades.png" },
      { titleHtml: '<em>Agenda</em> integrada', desc: "Calendário visual com sincronização bidirecional com Google Agenda e Apple Agenda. Reuniões e visitas entram automaticamente.", img: "/images/tabs/vendas-agenda.png" },
    ],
  },
  {
    key: "marketing",
    label: "Marketing",
    slides: [
      { titleHtml: 'Marketing e vendas sobre a <em>mesma base</em>', desc: "Crie audiências com critérios do CRM e dispare campanhas de WhatsApp e e-mail. Segmentação, disparo e métricas sem ferramenta externa.", img: "/images/tabs/marketing-base.png" },
      { titleHtml: 'Campanhas de WhatsApp <em>em massa</em>', desc: "Disparo via API Oficial da Meta. Fluxo em quatro passos: configuração, audiência, template, revisão. Cancela se o cliente responder antes.", img: "/images/tabs/marketing-campanhas-whatsapp.png" },
      { titleHtml: 'Campanhas de <em>e-mail</em>', desc: "Mesmo fluxo, mesma audiência, canal diferente. WhatsApp e e-mail sobre a mesma base de dados, sem exportar lista.", img: "/images/tabs/marketing-campanhas-email.jpeg" },
      { titleHtml: 'Automações com <em>lógica condicional</em>', desc: "Fluxos disparados por eventos do sistema. Gatilhos, condições, atrasos e ações internas e externas no meio do fluxo.", img: "/images/tabs/marketing-automacoes.png" },
    ],
  },
  {
    key: "ia",
    label: "Inteligência artificial",
    slides: [
      { titleHtml: '<em>IA</em> que trabalha enquanto seu time vende', desc: "A IA lê todas as conversas do WhatsApp, entende o contexto e atualiza o CRM automaticamente. Adicional opcional.", img: "/images/tabs/ia-crm.png" },
      { titleHtml: 'Agente <em>SDR</em> 24 horas no WhatsApp', desc: "Atende leads novos, faz perguntas de qualificação, executa follow-ups e reengaja quem parou de responder. Encaminha com contexto completo. Adicional opcional.", img: "/images/tabs/ia-sdr.png" },
      { titleHtml: 'Áudios <em>transcritos</em> automaticamente', desc: "Transcreve áudios recebidos e enviados nas conversas do WhatsApp. A transcrição fica ao lado da mensagem original. Adicional opcional.", img: "/images/tabs/ia-audios.png" },
      { titleHtml: '<em>Relatórios</em> executivos com IA', desc: "A IA analisa os dados do CRM, as conversas e o histórico do pipeline para gerar relatórios prontos para o gestor. Desempenho do time, saúde do funil, gargalos e tendências. Adicional opcional.", img: "/images/tabs/ia-relatorios.png" },
    ],
  },
];
---

<section class="areas-section" id="modulos">
  <div class="container">
    <div class="areas-head">
      <div class="eyebrow eyebrow--light">Solução por área</div>
      <h2 class="section-title">Quatro frentes.<br>Um <em>sistema</em>.</h2>
      <p class="section-sub">Cada área do seu comercial tem funcionalidades específicas dentro da Voe.</p>
    </div>

    <div id="areasContainer">
      {AREAS.map((area) => (
        <div class="area-block" id={`area-${area.key}`}>
          <span class={`area-badge area-${area.key}`}>{area.label}</span>
          <div class="area-card">
            <div class="area-slide" data-role="slide">
              <div class="area-slide-left">
                <h3 data-role="title" set:html={area.slides[0].titleHtml}></h3>
                <p data-role="desc">{area.slides[0].desc}</p>
              </div>
              <div class="area-slide-right">
                <div class="area-screenshot" data-role="mock">
                  {area.slides[0].img
                    ? <img src={area.slides[0].img} alt={area.slides[0].titleHtml.replace(/<[^>]*>/g, '')} class="area-img" />
                    : <span class="area-placeholder">Screenshot em breve</span>
                  }
                </div>
              </div>
            </div>
            <div class="area-controls">
              <div class="area-counter">
                <span class="area-counter-current" data-role="current">1</span>
                <span> / {area.slides.length}</span>
              </div>
              <div class="area-nav">
                <div class="area-dots" data-role="dots">
                  {area.slides.map((_, i) => (
                    <button class={`area-dot ${i === 0 ? 'is-active' : ''}`} aria-label={`Slide ${i+1}`} data-index={i}></button>
                  ))}
                </div>
                <div class="area-arrows">
                  <button class="area-arrow" data-role="prev" aria-label="Anterior">‹</button>
                  <button class="area-arrow" data-role="next" aria-label="Próximo">›</button>
                </div>
              </div>
            </div>
          </div>
          <script type="application/json" class="area-slides-data" data-area={area.key} set:html={JSON.stringify(area.slides)}></script>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  (function() {
    const blocks = document.querySelectorAll('.area-block');
    
    blocks.forEach(block => {
      const dataScript = block.querySelector('.area-slides-data');
      if (!dataScript) return;
      const slides = JSON.parse(dataScript.innerHTML);
      
      const slideEl = block.querySelector('[data-role="slide"]');
      const titleEl = block.querySelector('[data-role="title"]');
      const descEl  = block.querySelector('[data-role="desc"]');
      const mockEl  = block.querySelector('[data-role="mock"]');
      const currentEl = block.querySelector('[data-role="current"]');
      const dots = block.querySelectorAll('.area-dot');
      const prevBtn = block.querySelector('[data-role="prev"]');
      const nextBtn = block.querySelector('[data-role="next"]');

      let idx = 0;
      let busy = false;

      function updateMock(s) {
        if (!mockEl) return;
        if (s.img) {
          mockEl.innerHTML = `<img src="${s.img}" alt="" class="area-img" />`;
        } else {
          mockEl.innerHTML = `<span class="area-placeholder">Screenshot em breve</span>`;
        }
      }

      function goTo(targetIdx) {
        if (busy || targetIdx === idx) return;
        busy = true;

        if (targetIdx < 0) targetIdx = slides.length - 1;
        if (targetIdx >= slides.length) targetIdx = 0;

        slideEl.classList.add('is-fading');
        dots.forEach(d => d.classList.remove('is-active'));
        dots[targetIdx].classList.add('is-active');

        setTimeout(() => {
          idx = targetIdx;
          const s = slides[idx];
          titleEl.innerHTML = s.titleHtml;
          descEl.innerHTML = s.desc;
          currentEl.textContent = (idx + 1).toString();
          updateMock(s);

          slideEl.classList.remove('is-fading');
          setTimeout(() => { busy = false; }, 200);
        }, 200);
      }

      dots.forEach(dot => {
        dot.addEventListener('click', () => goTo(parseInt(dot.getAttribute('data-index'), 10)));
      });

      if (prevBtn) {
        prevBtn.addEventListener('click', () => goTo(idx - 1));
      }
      if (nextBtn) {
        nextBtn.addEventListener('click', () => goTo(idx + 1));
      }
    });
  })();
</script>

<style>
  /* ——— Section: Áreas (carousel por área, escuro) ——— */
  .areas-section {
    padding: 130px 0 110px;
    background: #1f3046;
    color: var(--off-white, #F5F6F2);
    position: relative; overflow: hidden;
  }
  .areas-section::before {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(720px 420px at 10% 10%, rgba(0, 197, 180, 0.10), transparent 60%),
      radial-gradient(720px 420px at 95% 95%, rgba(0, 197, 180, 0.06), transparent 60%);
  }
  .areas-section .container { position: relative; z-index: 1; }
  .areas-section .areas-head { max-width: 760px; margin-bottom: 64px; }
  


  .areas-section .areas-head .eyebrow { color: rgba(237,239,234,0.6); }
  .areas-section .areas-head .eyebrow::before { background: var(--turquesa, #00C5B4); }
  .areas-section .areas-head .section-title { color: #fff; margin-bottom: 18px; }
  .areas-section .areas-head .section-title em { color: var(--turquesa, #00C5B4); }
  .areas-section .areas-head .section-sub { color: rgba(237,239,234,0.7); margin: 0; }

  .area-block { padding: 40px 0 48px; border-top: 1px solid rgba(255,255,255,0.10); scroll-margin-top: 100px; }
  .area-block:first-of-type { border-top: 0; padding-top: 0; }
  .area-block:last-of-type { padding-bottom: 0; }

  .area-badge {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 6px 14px; border-radius: 100px;
    font-family: var(--font-mono, monospace); font-size: 11px; letter-spacing: 0.06em;
    text-transform: uppercase; font-weight: 500;
    margin-bottom: 22px;
    border: 1px solid transparent;
  }
  .area-badge.area-atendimento,
  .area-badge.area-vendas,
  .area-badge.area-marketing,
  .area-badge.area-ia {
    background: rgba(224, 66, 42, 0.14);
    color: #ed8870;
    border-color: rgba(224, 66, 42, 0.32);
  }

  .area-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 14px;
    overflow: hidden;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    box-shadow: 0 1px 0 rgba(255,255,255,0.04), 0 24px 60px -20px rgba(0,0,0,0.45);
  }
  .area-slide {
    display: grid; grid-template-columns: 30% 1fr;
    min-height: 380px;
  }
  .area-slide-left {
    padding: 44px 40px;
    display: flex; flex-direction: column; gap: 18px;
    transition: opacity 0.2s ease;
  }
  .area-slide-left h3 {
    font-family: var(--font-display, sans-serif); 
    font-size: clamp(1.5rem, 3vw, 2rem); 
    font-weight: 600;
    line-height: 1.1; 
    letter-spacing: -0.02em; 
    color: #fff;
    text-wrap: balance;
    margin: 0;
  }
  .area-slide-left h3 :global(em) {
    font-family: var(--font-serif, serif);
    font-style: italic;
    font-weight: 400;
    color: var(--turquesa);
  }
  .area-slide-left p {
    font-size: 1rem; 
    line-height: 1.7; 
    color: var(--text-on-dark-secondary);
    max-width: 380px;
    margin: 0;
  }
  .area-slide-right {
    padding: 0;
    background: rgba(0,0,0,0.18);
    display: flex; align-items: stretch; justify-content: stretch;
    transition: opacity 0.2s ease;
  }
  .area-slide-right .area-screenshot {
    flex: 1;
    background: var(--bg-secondary, #F5F6F2);
    border: 0;
    border-radius: 0;
    box-shadow: none;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-mono, monospace); font-size: 12px; color: var(--text-muted, #8a929b);
    letter-spacing: 0.02em;
    overflow: hidden;
    min-height: 320px;
  }
  .area-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: top center;
    display: block;
  }

  .area-placeholder {
    font-family: var(--font-mono, monospace);
    font-size: 12px;
    color: var(--text-muted, #8a929b);
    letter-spacing: 0.02em;
  }

  .area-slide.is-fading .area-slide-left,
  .area-slide.is-fading .area-slide-right { opacity: 0; }

  .area-controls {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 28px; border-top: 1px solid rgba(255,255,255,0.10);
    background: rgba(255,255,255,0.02);
  }
  .area-counter {
    font-family: var(--font-mono, monospace); font-size: 12px; color: rgba(237,239,234,0.6);
    letter-spacing: 0.04em;
  }
  .area-counter .area-counter-current { color: #fff; font-weight: 500; }

  .area-nav { display: flex; align-items: center; gap: 32px; }
  .area-dots { display: flex; align-items: center; gap: 10px; }
  .area-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: rgba(255,255,255,0.2); padding: 0; margin: 0; border: 0;
    cursor: pointer; transition: all 0.2s;
  }
  .area-dot:hover { background: rgba(255,255,255,0.4); }
  .area-dot.is-active { background: var(--turquesa, #00C5B4); transform: scale(1.3); }

  .area-arrows { display: flex; align-items: center; gap: 8px; }
  .area-arrow {
    width: 32px; height: 32px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08);
    color: rgba(255,255,255,0.6); font-size: 18px; cursor: pointer;
    transition: all 0.2s; padding: 0; margin: 0;
    line-height: 1;
  }
  .area-arrow:hover { background: rgba(255,255,255,0.12); color: #fff; border-color: rgba(255,255,255,0.2); }

  @media (max-width: 900px) {
    .area-slide { grid-template-columns: 1fr; min-height: auto; }
    .area-slide-left { padding: 32px 24px; }
    .area-slide-right .area-screenshot { min-height: 240px; }
  }
</style>
