---
// ComparisonTable.astro — Feature comparison matrix
const check = '✓';
const dash = '—';
const soon = 'em breve';

const categories = [
  {
    name: 'Atendimento',
    features: [
      ['Inbox de conversas do WhatsApp', check, check, check, check],
      ['WhatsApp API Oficial', check, check, check, check],
      ['WhatsApp API Voe (QR Code)', check, check, check, check],
      [`Inbox Instagram Direct [${soon}]`, check, check, check, check],
      ['Armazenamento de mídia por usuário', '1 GB', '3 GB', '6 GB', 'Personalizado'],
      [`Ferramenta de limpeza de mídia [${soon}]`, check, check, check, check],
      ['Central de Modelos de mensagem', check, check, check, check],
      ['Painel do Lead na conversa', check, check, check, check],
      ['Fila de Atendimento', check, check, check, check],
      ['Supervisão de Conversas', check, check, check, check],
      [`Relatórios de atendimento [${soon}]`, check, check, check, check],
    ],
  },
  {
    name: 'CRM',
    features: [
      ['Negociações ilimitadas', check, check, check, check],
      ['Contatos ilimitados', check, check, check, check],
      ['Empresas ilimitadas', check, check, check, check],
      ['Funil de Vendas (Kanban e lista)', check, check, check, check],
      ['Múltiplos funis simultâneos', dash, '3', '10', 'Personalizado'],
      ['Etapas personalizáveis', check, check, check, check],
      ['Distribuição inteligente de leads', check, check, check, check],
      ['Pausa na distribuição de leads nas férias', check, check, check, check],
      ['Qualificação por estrelas personalizável', check, check, check, check],
      ['Campos personalizados', check, check, check, check],
      [`Campos obrigatórios por etapa [${soon}]`, check, check, check, check],
      ['Produtos e serviços na negociação', check, check, check, check],
      [`Gerador de Propostas [${soon}]`, dash, check, check, check],
      ['Anotações e linha do tempo da negociação', check, check, check, check],
      ['Agendamento de envio de WhatsApp', dash, check, check, check],
      [`E-mail direto na negociação [${soon}]`, check, check, check, check],
      [`Ligações VOIP [${soon}]`, check, check, check, check],
      [`Gravação de ligações VOIP [${soon}]`, check, check, check, check],
      [`Importar / exportar base de leads [${soon}]`, check, check, check, check],
      ['Conformidade com a LGPD', check, check, check, check],
    ],
  },
  {
    name: 'Agenda',
    features: [
      ['Agenda do usuário', dash, check, check, check],
      ['Agenda de datas de eventos (setor de eventos)', dash, check, check, check],
      [`Integração com Google e Apple Calendar [${soon}]`, dash, check, check, check],
    ],
  },
  {
    name: 'Audiências',
    features: [
      ['Criação de audiências para disparos em massa', dash, dash, check, check],
      ['Criação de audiências para automações', dash, dash, check, check],
      ['Audiências estáticas', dash, dash, '30', 'Personalizado'],
      ['Audiências dinâmicas', dash, dash, '10', 'Personalizado'],
      [`Lead Scoring [${soon}]`, dash, dash, check, check],
    ],
  },
  {
    name: 'Campanhas',
    features: [
      ['Criação e aprovação de mensagens WhatsApp', check, check, check, check],
      ['Disparos em massa via WhatsApp (API Oficial)', dash, dash, '10 mil/mês', 'Personalizado'],
      [`Disparos em massa via e-mail [${soon}]`, dash, dash, '10 mil/mês', 'Personalizado'],
      [`Status de envio em tempo real [${soon}]`, dash, dash, check, check],
      [`Análise de performance de disparos [${soon}]`, dash, dash, check, check],
      [`Botão de WhatsApp no site [${soon}]`, dash, dash, check, check],
      [`Pop-ups [${soon}]`, dash, dash, check, check],
      [`Criador de formulários [${soon}]`, dash, dash, check, check],
    ],
  },
  {
    name: 'Automações',
    features: [
      ['Automações personalizadas', dash, '3 ativas', '10 ativas', 'Personalizado'],
      ['WhatsApp nas automações', dash, dash, check, check],
      [`Automação de e-mail sequencial [${soon}]`, dash, dash, '10 fluxos', 'Personalizado'],
      [`Chatbot de recepção e direcionamento [${soon}]`, dash, '3 fluxos', '10 fluxos', 'Personalizado'],
    ],
  },
  {
    name: 'Relatórios',
    features: [
      [`Relatórios básicos de vendas [${soon}]`, check, check, check, check],
      [`Relatórios completos de funil [${soon}]`, dash, check, check, check],
      [`Relatórios avançados de marketing e vendas [${soon}]`, dash, dash, check, check],
    ],
  },
  {
    name: 'Configurações e Administração',
    features: [
      ['Gestão de visibilidade por usuário', check, check, check, check],
      ['Permissões personalizadas', check, check, check, check],
      ['Configuração de equipes', dash, check, check, check],
    ],
  },
  {
    name: 'Suporte e Comunidade',
    features: [
      ['Suporte reativo', 'SLA 8h', 'SLA 6h', 'SLA 4h', 'SLA 2h'],
      ['Gerente de contas dedicado', dash, dash, dash, check],
      ['Suporte ativo', dash, dash, check, check],
      [`Comunidade Voe no WhatsApp [${soon}]`, dash, check, check, check],
      [`Plantão Voe por videoconferência [${soon}]`, dash, check, check, check],
    ],
  },
];

const plans = ['Starter', 'Growth', 'Scale', 'Enterprise'];

function renderFeatureName(name: string) {
  return name.replace('[em breve]', '<span class="soon">em breve</span>');
}
---

<section class="sec-comparativo" id="comparativo">
  <div class="container">
    <div class="comp-hd" data-animate="fade-up">
      <h2>O que cada plano <em>inclui</em></h2>
      <p>Todas as funcionalidades, linha a linha. Itens marcados como "em breve" estão em desenvolvimento.</p>
    </div>

    <div class="comp-card" data-animate="fade-up" data-delay="0.2">
      <div class="scroll-gap-mask"></div>
      <div class="comp-table-wrap">
        <table class="comp-table">
          <thead>
            <tr>
              <th class="th-corner"></th>
              {plans.map((p, index) => (
                <th class={index === 2 ? "th-featured" : ""}>
                  <div class="th-content-wrap">
                    {index === 2 && <span class="badge-popular">Mais escolhido</span>}
                    <div class="plan-col-head">
                      <span class="plan-col-dot"></span>
                      <span class="plan-col-name">{p}</span>
                    </div>
                  </div>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {categories.map(cat => (
              <>
                <tr class="group-row">
                  <td class="group-name-cell">
                    <span class="group-row-label">{cat.name}</span>
                  </td>
                  <td class="group-cell"></td>
                  <td class="group-cell"></td>
                  <td class="group-cell group-cell-featured"></td>
                  <td class="group-cell"></td>
                </tr>
                {cat.features.map(row => (
                  <tr class="feat-row">
                    <td class="feat-name" set:html={renderFeatureName(row[0] as string)} />
                    {[1,2,3,4].map(i => (
                      <td class={i === 3 ? "feat-cell feat-cell-featured" : "feat-cell"}>
                        {row[i] === check ? (
                          <span class="ic-yes">✓</span>
                        ) : row[i] === dash ? (
                          <span class="ic-no">—</span>
                        ) : row[i] === 'Personalizado' ? (
                          <span class="ic-unlimited">{row[i]}</span>
                        ) : (
                          <span class="ic-val">{row[i]}</span>
                        )}
                      </td>
                    ))}
                  </tr>
                ))}
              </>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<style>
  .sec-comparativo { padding: 130px 0 0; }
  .comp-hd { margin-bottom: 48px; }
  .comp-hd h2 {
    font-family: var(--font-display);
    font-size: clamp(40px, 5.6vw, 76px); font-weight: 600; color: var(--ardosia);
    letter-spacing: -0.04em; line-height: 1.0; text-wrap: pretty;
  }
  .comp-hd h2 em { font-family: var(--font-serif); font-style: italic; font-weight: 400; color: var(--terracotta); letter-spacing: -0.02em; }
  .comp-hd p { font-family: var(--font-body); font-size: 18px; color: var(--charcoal-2); margin-top: 18px; max-width: 580px; line-height: 1.55; text-wrap: pretty; }

  .comp-card {
    background: #ffffff; /* Fundo totalmente branco forçado */
    border: 1px solid rgba(0,0,0,0.04);
    border-radius: var(--radius-lg);
    box-shadow: 0 12px 32px rgba(48,69,91,0.04);
    margin-top: 24px; /* Espaço pro badge popular estourar pra fora com folga */
  }

  
  .comp-table {
    width: 100%; border-collapse: separate; border-spacing: 0; font-size: 13px; background: transparent;
    table-layout: fixed;
  }
  
  .scroll-gap-mask {
    position: sticky;
    top: 112px;
    left: 0;
    right: 0;
    height: 48px; /* 18px da fresta + 30px extras para descer atrás do cabeçalho e cobrir os cantos arredondados */
    background: #EDEFEA;
    z-index: 4;
    pointer-events: none;
    margin-bottom: -48px;
  }
  
  /* STICKY HEADER COM GLASSMORPHISM */
  .comp-table thead tr th {
    padding: 30px 8px 10px; /* Mantém o 50/50 do badge */
    background: rgba(36, 51, 69, 0.60); /* Aumentada a transparência (era 0.78) */
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    border: none;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    position: sticky; 
    top: 130px; /* Cria a fresta exata de 18px abaixo do AnchorNav */
    z-index: 5;
    vertical-align: middle;
    background-clip: padding-box;
  }
  
  /* ARREDONDAMENTO DAS 4 PONTAS DA TABELA */
  .comp-table thead tr th:first-child {
    text-align: left; width: 36%;
    left: 0; z-index: 6;
    border-top-left-radius: var(--radius-lg);
    overflow: hidden; /* Força o recorte do glassmorphism no Safari */
  }
  .comp-table thead tr th:last-child {
    border-top-right-radius: var(--radius-lg);
    overflow: hidden; /* Força o recorte do glassmorphism no Safari */
  }
  
  .comp-table tbody tr td:first-child {
    position: sticky; left: 0; z-index: 3;
    background: #ffffff; /* Para cobrir ao rolar horizontalmente */
  }
  .comp-table thead tr th:not(:first-child) {
    text-align: center; width: 16%;
    border-left: 1px solid rgba(0,0,0,0.04);
  }

  .th-content-wrap {
    position: relative; /* Container que ancora o badge absoluto */
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* DESTAQUE DO PLANO SCALE - APENAS NAS LINHAS DE FEATURES (MANTÉM BADGE NO HEADER) */
  .comp-table tbody tr td.feat-cell-featured + td {
    border-left: none !important;
  }
  .badge-popular {
    position: absolute;
    top: -40px; /* Ajuste compensando os 30px de top padding + 10px metade do badge */
    left: 50%;
    transform: translateX(-50%);
    background: var(--turquesa);
    color: #fff;
    font-size: 10px; font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border-radius: 100px;
    box-shadow: 0 2px 6px rgba(0, 197, 180, 0.3);
    white-space: nowrap;
    z-index: 20;
  }

  .plan-col-head {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px;
  }
  .plan-col-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--turquesa);
    box-shadow: 0 0 0 4px rgba(0,197,180,0.18);
  }
  .plan-col-name {
    font-family: var(--font-display);
    font-size: 16px; /* Fonte reduzida para diminuir altura do cabeçalho */
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #ffffff;
    line-height: 1;
  }

  /* LINHAS DE GRUPO (CATEGORIAS) */
  .comp-table tbody tr.group-row td {
    padding: 16px 18px 12px; /* Altura um pouco menor também */
    font-family: var(--font-display);
    background: #fafafa; /* Levemente cinza pra destacar a quebra */
    border-top: 1px solid rgba(0,0,0,0.03);
    border-bottom: 1px solid rgba(0,0,0,0.06);
  }
  .group-row-label {
    display: inline-flex; align-items: center;
    font-size: 12px; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.12em; color: var(--ardosia);
  }
  .group-row-label::before {
    content: ''; display: inline-block;
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--turquesa);
    margin-right: 10px;
  }

  /* LINHAS DE FEATURES */
  .comp-table tbody tr.feat-row td {
    padding: 12px 18px; /* Menor respiro para deixar tabela mais compacta */
    border-bottom: 1px solid rgba(0,0,0,0.04); /* Borda bem suave */
    background: #ffffff;
    transition: background 0.2s ease;
  }
  .comp-table tbody tr.feat-row:last-child td {
    border-bottom: none;
  }
  .comp-table tbody tr:last-child td:first-child {
    border-bottom-left-radius: var(--radius-lg);
    overflow: hidden;
  }
  .comp-table tbody tr:last-child td:last-child {
    border-bottom-right-radius: var(--radius-lg);
    overflow: hidden;
  }
  
  /* EFEITO DE HOVER REFINADO */
  .comp-table tbody tr.feat-row:hover td { 
    background: #f4f8f7 !important; /* Força o hover por cima do branco */
  }
  .comp-table tbody tr.feat-row td.feat-cell-featured {
    background: #F4FBFA;
    border-left: 1px solid rgba(0, 197, 180, 0.15);
    border-right: 1px solid rgba(0, 197, 180, 0.15);
  }
  .comp-table tbody tr.feat-row:hover td.feat-cell-featured {
    background: #E8F5F4 !important;
  }

  .comp-table tbody tr.feat-row td:first-child {
    color: var(--charcoal); font-size: 13px; font-weight: 500;
  }
  .comp-table tbody tr.feat-row td:not(:first-child) {
    text-align: center;
    border-left: 1px solid var(--border-light);
  }

  /* BADGE "EM BREVE" */
  .comp-table tbody tr.feat-row td.feat-name :global(.soon) {
    display: inline-block;
    font-size: 9px; font-weight: 700;
    color: var(--terracotta);
    background: rgba(224, 66, 42, 0.08);
    border: 1px solid rgba(224, 66, 42, 0.15);
    border-radius: 100px;
    padding: 2px 8px;
    margin-left: 8px;
    vertical-align: text-top;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* ICONS E VALORES */
  .ic-yes {
    display: inline-flex; align-items: center; justify-content: center;
    width: 20px; height: 20px; border-radius: 50%;
    background: linear-gradient(135deg, var(--turquesa) 0%, #00a89a 100%);
    color: #fff;
    font-size: 0;
    box-shadow: 0 2px 4px rgba(0,197,180,0.2);
  }
  .ic-yes::before {
    content: ''; display: block;
    width: 9px; height: 9px;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 10 10' fill='none'><path d='M1.5 5L3.8 7.5L8.5 2' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/></svg>");
    background-repeat: no-repeat; background-position: center;
  }
  .ic-no  {
    display: inline-block;
    width: 14px; height: 2px;
    background: #cbd5e1; border-radius: 2px;
    font-size: 0; vertical-align: middle;
  }
  .ic-val {
    font-family: var(--font-display); font-weight: 600;
    font-size: 14px; color: var(--ardosia); letter-spacing: -0.01em;
  }
  .ic-unlimited {
    display: inline-block;
    padding: 4px 12px;
    background: rgba(0,197,180,0.1);
    color: var(--turquesa);
    font-weight: 700; font-size: 10px;
    border-radius: 100px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .comp-table thead tr th.th-featured { border-left-width: 0; border-right-width: 0; }
    .comp-table tbody tr.feat-row td.feat-cell-featured { border-left: 1px solid var(--border-light); border-right-width: 0; }
  }

  @media (max-width: 560px) {
    .sec-comparativo { padding: 48px 0 0; }
    .comp-card { border-radius: var(--radius-md); }
    .comp-table { min-width: 680px; }
    .comp-table thead tr th { padding: 12px 8px; }
    .comp-table thead tr th:first-child { width: 32%; }
    .comp-table thead tr th:not(:first-child) { width: 17%; }
    .plan-col-name { font-size: 13px; }
    .plan-col-dot { width: 4px; height: 4px; box-shadow: 0 0 0 3px rgba(0,197,180,0.18); }
    .badge-popular { font-size: 8px; padding: 2px 6px; top: -18px; }
    .comp-table tbody tr.feat-row td { padding: 10px 10px; font-size: 12px; }
    .comp-table tbody tr.feat-row td:first-child { font-size: 12px; }
    .comp-table tbody tr.group-row td { padding: 12px 10px 10px; }
    .group-row-label { font-size: 10px; }
    .ic-yes { width: 18px; height: 18px; }
    .ic-val { font-size: 12px; }
    .comp-table-wrap {
      overflow-x: auto; -webkit-overflow-scrolling: touch;
      scrollbar-width: thin;
    }
    .comp-table-wrap::after {
      content: '← deslize para ver todos os planos →';
      display: block; text-align: center;
      font-size: 11px; color: var(--txt-muted);
      padding: 12px 0 6px; letter-spacing: 0.02em;
    }
  }
</style>
