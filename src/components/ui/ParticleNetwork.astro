---
// src/components/ui/ParticleNetwork.astro
---
<canvas id="particle-network" aria-hidden="true"></canvas>

<style>
  #particle-network {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 10;
    pointer-events: none;
  }
</style>

<script>
  (function () {
    const canvas = document.getElementById('particle-network') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const DPR = Math.min(window.devicePixelRatio || 1, 2);

    const CFG = {
      countDesktop: 80,
      countMobile: 50,
      r: 0, g: 197, b: 180,
      dotRadius: 1.8,
      dotOpacity: 0.18,
      speed: 0.32,
      connectDist: 130,
      mouseDist: 160,
      lineMaxOpacity: 0.08,
      lineWidth: 0.5,
    };

    let W = 0, H = 0;
    let mouse = { x: -9999, y: -9999 };
    let pts: { x: number; y: number; vx: number; vy: number }[] = [];
    let animId = 0;

    function resize() {
      W = window.innerWidth;
      H = window.innerHeight;
      canvas.width = Math.round(W * DPR);
      canvas.height = Math.round(H * DPR);
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    }

    function spawn() {
      const n = W < 768 ? CFG.countMobile : CFG.countDesktop;
      pts = [];
      for (let i = 0; i < n; i++) {
        const angle = Math.random() * Math.PI * 2;
        const speed = CFG.speed * (0.6 + Math.random() * 0.8);
        pts.push({
          x: Math.random() * W,
          y: Math.random() * H,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
        });
      }
    }

    function tick() {
      ctx.clearRect(0, 0, W, H);
      const { r, g, b } = CFG;

      // update positions
      for (const p of pts) {
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0) p.x = W;
        else if (p.x > W) p.x = 0;
        if (p.y < 0) p.y = H;
        else if (p.y > H) p.y = 0;
      }

      // draw lines between particles
      ctx.lineWidth = CFG.lineWidth;
      for (let i = 0; i < pts.length; i++) {
        const a = pts[i];
        for (let j = i + 1; j < pts.length; j++) {
          const bv = pts[j];
          const dx = a.x - bv.x;
          const dy = a.y - bv.y;
          const d = Math.sqrt(dx * dx + dy * dy);
          if (d < CFG.connectDist) {
            const alpha = (1 - d / CFG.connectDist) * CFG.lineMaxOpacity;
            ctx.strokeStyle = `rgba(${r},${g},${b},${alpha})`;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(bv.x, bv.y);
            ctx.stroke();
          }
        }

        // draw line to mouse
        const mdx = a.x - mouse.x;
        const mdy = a.y - mouse.y;
        const md = Math.sqrt(mdx * mdx + mdy * mdy);
        if (md < CFG.mouseDist) {
          const alpha = (1 - md / CFG.mouseDist) * CFG.lineMaxOpacity * 2.2;
          ctx.strokeStyle = `rgba(${r},${g},${b},${alpha})`;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(mouse.x, mouse.y);
          ctx.stroke();
        }
      }

      // draw dots
      ctx.fillStyle = `rgba(${r},${g},${b},${CFG.dotOpacity})`;
      for (const p of pts) {
        ctx.beginPath();
        ctx.arc(p.x, p.y, CFG.dotRadius, 0, Math.PI * 2);
        ctx.fill();
      }

      animId = requestAnimationFrame(tick);
    }

    let resizeTimer = 0;

    function init() {
      resize();
      spawn();
      tick();

      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          cancelAnimationFrame(animId);
          animId = 0;
          resize();
          spawn();
          tick();
        }, 150);
      });

      window.addEventListener('mousemove', (e: MouseEvent) => {
        mouse.x = e.clientX;
        mouse.y = e.clientY;
      });

      window.addEventListener('mouseleave', () => {
        mouse.x = -9999;
        mouse.y = -9999;
      });

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          cancelAnimationFrame(animId);
          animId = 0;
        } else if (!animId) {
          tick();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
