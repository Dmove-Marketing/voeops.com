---
---

<div class="dot-grid-container" data-dotgrid-interactive style="position:absolute;inset:0;pointer-events:none;z-index:0;overflow:hidden;">
  <canvas class="dot-grid-canvas" style="position:absolute;inset:0;width:100%;height:100%;"></canvas>
  <div class="dot-grid-glow" style="
    position:absolute;
    top:50%;
    left:50%;
    transform:translate(-50%,-50%);
    width:600px;
    height:400px;
    background:radial-gradient(ellipse at center, rgba(0,197,180,0.04), transparent 70%);
    filter:blur(50px);
    pointer-events:none;
  "></div>
</div>

<script>
  function initDotGrids() {
    const containers = document.querySelectorAll('[data-dotgrid-interactive]');
    containers.forEach((container) => {
      const canvas = container.querySelector('.dot-grid-canvas') as HTMLCanvasElement;
      if (!canvas) return;

      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const SPACING = 24;
      const INFLUENCE_RADIUS = 180;
      const ATTRACT_DIST = 16;
      const BASE_SIZE = 0.9;
      const MAX_SIZE = 2.8;
      const LERP_ATTRACT = 0.2;
      const LERP_RETURN = 0.08;

      let dots: { ox: number; oy: number; x: number; y: number }[] = [];
      let mouse = { x: -9999, y: -9999, active: false };
      let animId: number;
      let width = 0;
      let height = 0;

      function buildDots() {
        const dpr = window.devicePixelRatio || 1;
        const rect = container.getBoundingClientRect();
        width = rect.width;
        height = rect.height;
        canvas.width = width * dpr;
        canvas.height = height * dpr;
        ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

        dots = [];
        const cols = Math.ceil(width / SPACING) + 1;
        const rows = Math.ceil(height / SPACING) + 1;
        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            const ox = c * SPACING;
            const oy = r * SPACING;
            dots.push({ ox, oy, x: ox, y: oy });
          }
        }
      }

      function lerp(a: number, b: number, t: number) {
        return a + (b - a) * t;
      }

      function draw() {
        ctx!.clearRect(0, 0, width, height);

        const cx = width / 2;
        const cy = height / 2;
        const maxCenterDist = Math.sqrt(cx * cx + cy * cy);

        for (let i = 0; i < dots.length; i++) {
          const dot = dots[i];

          // Distance from dot original position to mouse
          const dmx = mouse.x - dot.ox;
          const dmy = mouse.y - dot.oy;
          const distToMouse = Math.sqrt(dmx * dmx + dmy * dmy);

          // Attraction effect (ae: 0 far, 1 close)
          let ae = 0;
          if (mouse.active && distToMouse < INFLUENCE_RADIUS) {
            ae = 1 - distToMouse / INFLUENCE_RADIUS;

            // Attract toward mouse
            const angle = Math.atan2(dmy, dmx);
            const attractAmount = ae * ATTRACT_DIST;
            const targetX = dot.ox + Math.cos(angle) * attractAmount;
            const targetY = dot.oy + Math.sin(angle) * attractAmount;
            dot.x = lerp(dot.x, targetX, LERP_ATTRACT);
            dot.y = lerp(dot.y, targetY, LERP_ATTRACT);
          } else {
            // Return to original position
            dot.x = lerp(dot.x, dot.ox, LERP_RETURN);
            dot.y = lerp(dot.y, dot.oy, LERP_RETURN);
          }

          // Center fade: dots at center less visible, edges more visible
          const dcx = dot.ox - cx;
          const dcy = dot.oy - cy;
          const centerDist = Math.sqrt(dcx * dcx + dcy * dcy);
          const edgeFactor = centerDist / maxCenterDist; // 0 at center, 1 at corners

          // Color interpolation based on proximity
          const green = Math.round(lerp(157, 197, ae));
          const blue = Math.round(lerp(140, 180, ae));

          // Alpha: base with center fade
          const baseAlpha = 0.15;
          const alpha = (baseAlpha + 0.55 * ae) * 0.6 * (0.3 + 0.7 * edgeFactor);

          // Size
          const size = BASE_SIZE + (MAX_SIZE - BASE_SIZE) * ae;

          ctx!.beginPath();
          ctx!.arc(dot.x, dot.y, size, 0, Math.PI * 2);
          ctx!.fillStyle = `rgba(0,${green},${blue},${alpha})`;
          ctx!.fill();
        }

        animId = requestAnimationFrame(draw);
      }

      // Event handling on parent section
      const parentSection = container.parentElement;
      if (parentSection) {
        parentSection.addEventListener('mousemove', (e: MouseEvent) => {
          const rect = container.getBoundingClientRect();
          mouse.x = e.clientX - rect.left;
          mouse.y = e.clientY - rect.top;
          mouse.active = true;
        });

        parentSection.addEventListener('mouseleave', () => {
          mouse.active = false;
          mouse.x = -9999;
          mouse.y = -9999;
        });

        parentSection.addEventListener('touchmove', (e: TouchEvent) => {
          const touch = e.touches[0];
          if (touch) {
            const rect = container.getBoundingClientRect();
            mouse.x = touch.clientX - rect.left;
            mouse.y = touch.clientY - rect.top;
            mouse.active = true;
          }
        }, { passive: true });

        parentSection.addEventListener('touchend', () => {
          mouse.active = false;
          mouse.x = -9999;
          mouse.y = -9999;
        });
      }

      // ResizeObserver evita reflow forçado: o callback dispara após layout concluído,
      // eliminando a sequência write→read síncrona que causava 83ms de bloqueio.
      const resizeObserver = new ResizeObserver(() => {
        requestAnimationFrame(buildDots);
      });
      resizeObserver.observe(container);

      buildDots();
      draw();
    });
  }

  document.addEventListener('DOMContentLoaded', initDotGrids);
</script>
