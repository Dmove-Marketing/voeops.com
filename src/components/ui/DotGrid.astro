---
---

<div class="dot-grid-container" data-dotgrid-interactive style="position:absolute;inset:0;pointer-events:none;z-index:0;overflow:hidden;">
  <canvas class="dot-grid-canvas" style="position:absolute;inset:0;width:100%;height:100%;"></canvas>
  <div class="dot-grid-glow" style="
    position:absolute;
    top:50%;
    left:50%;
    transform:translate(-50%,-50%);
    width:600px;
    height:400px;
    background:radial-gradient(ellipse at center, rgba(0,197,180,0.04), transparent 70%);
    filter:blur(50px);
    pointer-events:none;
  "></div>
</div>

<script>
  function initDotGrids() {
    const containers = document.querySelectorAll('[data-dotgrid-interactive]');
    containers.forEach((container) => {
      const canvas = container.querySelector('.dot-grid-canvas') as HTMLCanvasElement;
      if (!canvas) return;

      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const SPACING = 24;
      const INFLUENCE_RADIUS = 180;
      const INFLUENCE_RADIUS_SQ = INFLUENCE_RADIUS * INFLUENCE_RADIUS;
      const ATTRACT_DIST = 16;
      const BASE_SIZE = 0.9;
      const MAX_SIZE = 2.8;
      const LERP_ATTRACT = 0.2;
      const LERP_RETURN = 0.08;
      const SETTLE_SQ = 0.01; // snap to origin when displacement² < this

      let dots: { ox: number; oy: number; x: number; y: number; edgeFactor: number }[] = [];
      let mouse = { x: -9999, y: -9999, active: false };
      let isAnimating = false;
      let width = 0;
      let height = 0;

      function buildDots() {
        const dpr = window.devicePixelRatio || 1;
        const rect = container.getBoundingClientRect();
        width = rect.width;
        height = rect.height;
        canvas.width = width * dpr;
        canvas.height = height * dpr;
        ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

        const cx = width / 2;
        const cy = height / 2;
        const maxCenterDist = Math.sqrt(cx * cx + cy * cy);

        dots = [];
        const cols = Math.ceil(width / SPACING) + 1;
        const rows = Math.ceil(height / SPACING) + 1;
        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            const ox = c * SPACING;
            const oy = r * SPACING;
            // Pre-compute edgeFactor once — avoids sqrt per dot per frame
            const dcx = ox - cx;
            const dcy = oy - cy;
            const edgeFactor = Math.sqrt(dcx * dcx + dcy * dcy) / maxCenterDist;
            dots.push({ ox, oy, x: ox, y: oy, edgeFactor });
          }
        }
        drawStatic();
      }

      function lerp(a: number, b: number, t: number) {
        return a + (b - a) * t;
      }

      // Renders a single still frame — called after build and after animation settles
      function drawStatic() {
        ctx!.clearRect(0, 0, width, height);
        for (let i = 0; i < dots.length; i++) {
          const dot = dots[i];
          const alpha = 0.15 * 0.6 * (0.3 + 0.7 * dot.edgeFactor);
          ctx!.beginPath();
          ctx!.arc(dot.ox, dot.oy, BASE_SIZE, 0, Math.PI * 2);
          ctx!.fillStyle = `rgba(0,157,140,${alpha})`;
          ctx!.fill();
        }
      }

      function startAnimation() {
        if (isAnimating) return;
        isAnimating = true;
        draw();
      }

      function draw() {
        ctx!.clearRect(0, 0, width, height);
        let anyMoved = false;

        for (let i = 0; i < dots.length; i++) {
          const dot = dots[i];
          let ae = 0;

          const dmx = mouse.x - dot.ox;
          const dmy = mouse.y - dot.oy;
          const distSq = dmx * dmx + dmy * dmy;

          if (mouse.active && distSq < INFLUENCE_RADIUS_SQ) {
            const distToMouse = Math.sqrt(distSq); // sqrt only for dots in range
            ae = 1 - distToMouse / INFLUENCE_RADIUS;
            const angle = Math.atan2(dmy, dmx);
            const attractAmount = ae * ATTRACT_DIST;
            dot.x = lerp(dot.x, dot.ox + Math.cos(angle) * attractAmount, LERP_ATTRACT);
            dot.y = lerp(dot.y, dot.oy + Math.sin(angle) * attractAmount, LERP_ATTRACT);
            anyMoved = true;
          } else {
            const dx = dot.ox - dot.x;
            const dy = dot.oy - dot.y;
            if (dx * dx + dy * dy > SETTLE_SQ) {
              dot.x = lerp(dot.x, dot.ox, LERP_RETURN);
              dot.y = lerp(dot.y, dot.oy, LERP_RETURN);
              anyMoved = true;
            } else {
              dot.x = dot.ox;
              dot.y = dot.oy;
            }
          }

          const green = Math.round(lerp(157, 197, ae));
          const blue = Math.round(lerp(140, 180, ae));
          const alpha = (0.15 + 0.55 * ae) * 0.6 * (0.3 + 0.7 * dot.edgeFactor);
          const size = BASE_SIZE + (MAX_SIZE - BASE_SIZE) * ae;

          ctx!.beginPath();
          ctx!.arc(dot.x, dot.y, size, 0, Math.PI * 2);
          ctx!.fillStyle = `rgba(0,${green},${blue},${alpha})`;
          ctx!.fill();
        }

        if (anyMoved || mouse.active) {
          requestAnimationFrame(draw);
        } else {
          // All dots settled — stop the loop until next interaction
          isAnimating = false;
        }
      }

      const parentSection = container.parentElement;
      if (parentSection) {
        parentSection.addEventListener('mousemove', (e: MouseEvent) => {
          const rect = container.getBoundingClientRect();
          mouse.x = e.clientX - rect.left;
          mouse.y = e.clientY - rect.top;
          if (!mouse.active) {
            mouse.active = true;
            startAnimation();
          }
        });

        parentSection.addEventListener('mouseleave', () => {
          mouse.active = false;
          mouse.x = -9999;
          mouse.y = -9999;
          // Loop winds down naturally as dots return to origin
        });

        parentSection.addEventListener('touchmove', (e: TouchEvent) => {
          const touch = e.touches[0];
          if (touch) {
            const rect = container.getBoundingClientRect();
            mouse.x = touch.clientX - rect.left;
            mouse.y = touch.clientY - rect.top;
            if (!mouse.active) {
              mouse.active = true;
              startAnimation();
            }
          }
        }, { passive: true });

        parentSection.addEventListener('touchend', () => {
          mouse.active = false;
          mouse.x = -9999;
          mouse.y = -9999;
        });
      }

      const resizeObserver = new ResizeObserver(() => {
        requestAnimationFrame(buildDots);
      });
      resizeObserver.observe(container);

      buildDots();
    });
  }

  document.addEventListener('DOMContentLoaded', initDotGrids);
</script>
