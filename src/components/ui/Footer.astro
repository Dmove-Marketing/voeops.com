---
// src/components/ui/Footer.astro
// Voe CRM footer — 3 columns, dark bg
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <img src="/images/logo-voe2.svg" alt="Voe" class="footer-logo" />
        <p class="footer-tagline">Vendas, Marketing, WhatsApp e IA.<br/>Em um só lugar.</p>
      </div>

      <div class="footer-col">
        <h2 class="footer-heading">Produto</h2>
        <ul class="footer-links">
          <li><a href="/#area-atendimento">Atendimento</a></li>
          <li><a href="/#area-vendas">Vendas</a></li>
          <li><a href="/#area-marketing">Marketing</a></li>
          <li><a href="/#area-ia">Inteligência artificial</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h2 class="footer-heading">Links</h2>
        <ul class="footer-links">
          <li><a href="/planos">Planos e Preços</a></li>
          <li><a href="/#impl">Implementação</a></li>
          <li><a href="/ajuda">Central de Ajuda</a></li>
          <li><a href="/suporte">Suporte</a></li>
          <li><a href="https://wa.me/5511999803580" target="_blank" rel="noopener">Parceiros</a></li>
          <li><a href="https://app.voeops.com/login" target="_blank" rel="noopener">Login</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h2 class="footer-heading">Contato</h2>
        <ul class="footer-links">
          <li><a href="mailto:contato@voeops.com">contato@voeops.com</a></li>
          <li><a href="https://www.instagram.com/voeops/" target="_blank" rel="noopener">Instagram</a></li>
          <li><a href="https://www.linkedin.com/company/voeops/" target="_blank" rel="noopener">LinkedIn</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copyright">
        &copy; {currentYear} VOE SALES OPERATING SYSTEM. <span class="break-mobile">Todos os direitos reservados.</span>
      </p>
      <div class="footer-legal">
        <a href="https://voeops.com/politica-de-privacidade/">Política de Privacidade</a>
        <a href="https://voeops.com/termos/">Termos de Uso</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ardosia-dark);
    color: var(--text-on-dark);
    padding: var(--space-4xl) 0 var(--space-xl);
    position: relative;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: var(--space-2xl);
    padding-bottom: var(--space-2xl);
    border-bottom: 1px solid var(--glass-dark-border);
    margin-bottom: var(--space-xl);
  }

  .footer-logo {
    height: 32px;
    width: auto;
    margin-bottom: var(--space-md);
  }

  .footer-tagline {
    font-size: 0.9rem;
    color: var(--text-on-dark-secondary);
    line-height: 1.6;
  }

  .footer-heading {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(240, 242, 237, 0.80);
    margin-bottom: var(--space-md);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer-links a {
    font-size: 0.9rem;
    color: var(--text-on-dark-secondary);
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--turquesa);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .footer-copyright {
    font-size: 0.8rem;
    color: rgba(240, 242, 237, 0.75);
  }

  .footer-legal {
    display: flex;
    gap: var(--space-lg);
  }

  .footer-legal a {
    font-size: 0.8rem;
    color: rgba(240, 242, 237, 0.75);
    transition: color var(--transition-fast);
  }

  .footer-legal a:hover {
    color: var(--text-on-dark-secondary);
  }

  .break-mobile {
    display: inline;
  }

  @media (max-width: 768px) {
    .break-mobile {
      display: block;
      margin-top: 4px;
    }

    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }

    .footer-brand {
      grid-column: 1 / -1;
    }

    .footer-bottom {
      flex-direction: column;
      gap: var(--space-md);
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
