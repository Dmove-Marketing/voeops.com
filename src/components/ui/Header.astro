---
// src/components/ui/Header.astro
// Voe CRM header — sticky, dark bg, WhatsApp CTA
---

<header class="nav">
  <div class="container nav-inner">
    <div class="nav-left">
      <a href="/" class="logo" aria-label="Voe">
        <img src="/images/logo-voe2.svg" alt="Voe" class="logo-mark" />
      </a>
      <nav class="nav-links">
        <a href="/#produto">Produto</a>
        <a href="/planos">Planos</a>
        <a href="/#parceiros" data-chat-intent="parceria">Parceiros</a>
      </nav>
    </div>
    <div class="nav-right">
      <a href="https://app.voeops.com/login" target="_blank" rel="noopener" class="login">Login</a>
      <a href="https://wa.me/5511999803580" target="_blank" rel="noopener" class="btn btn-primary header-cta" data-cta="header-cta" data-chat-intent="demo">Agendar demonstração</a>
      <button class="header-hamburger" aria-label="Menu" aria-expanded="false">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </div>
</header>

<div class="header-mobile-menu" hidden>
  <nav>
    <ul class="mobile-links">
      <li><a href="/#produto" class="mobile-link">Produto</a></li>
      <li><a href="/planos" class="mobile-link">Planos</a></li>
      <li><a href="/#parceiros" class="mobile-link">Parceiros</a></li>
    </ul>
    <a href="https://app.voeops.com/login" class="mobile-login">Login</a>
    <a href="https://wa.me/5511999803580" target="_blank" rel="noopener" class="btn btn-primary mobile-cta" data-cta="mobile-cta">
      Agendar demonstração
    </a>
  </nav>
</div>

<script>
  function initHeader() {
    const header = document.querySelector('header.nav') as HTMLElement;
    const hamburger = document.querySelector('.header-hamburger') as HTMLButtonElement;
    const mobileMenu = document.querySelector('.header-mobile-menu') as HTMLElement;

    if (!header) return;

    window.addEventListener('scroll', () => {
      const currentScroll = window.scrollY;
      if (currentScroll > 80) {
        document.body.classList.add('scrolled');
      } else {
        document.body.classList.remove('scrolled');
      }
    });

    hamburger?.addEventListener('click', () => {
      const isOpen = hamburger.getAttribute('aria-expanded') === 'true';
      hamburger.setAttribute('aria-expanded', (!isOpen).toString());
      hamburger.classList.toggle('hamburger-active');

      if (isOpen) {
        mobileMenu.classList.remove('mobile-menu-open');
        setTimeout(() => { mobileMenu.hidden = true; }, 300);
        document.body.style.overflow = '';
      } else {
        mobileMenu.hidden = false;
        requestAnimationFrame(() => mobileMenu.classList.add('mobile-menu-open'));
        document.body.style.overflow = 'hidden';
      }
    });

    mobileMenu?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        hamburger.click();
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeader);
  } else {
    initHeader();
  }
</script>

<style>
  /* ——— Header (sobre hero escuro) ——— */
  header.nav {
    position: absolute; top: 0; left: 0; right: 0; z-index: 50;
    background: transparent;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    transition: background 0.3s ease, border-color 0.3s ease;
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 72px; gap: 24px; transition: height 0.3s ease; }
  .nav-left { display: flex; align-items: center; gap: 40px; }
  .logo { display: flex; align-items: center; gap: 9px; }
  .logo-mark { width: 64px; height: auto; display: block; }
  .logo-word { display: none; }
  .nav-links { display: flex; gap: 40px; }
  .nav-links a { font-size: 0.9rem; color: rgba(237,239,234,0.92); font-weight: 500; transition: color 0.15s; }
  .nav-links a:hover { color: var(--turquesa); }
  .nav-right { display: flex; align-items: center; gap: 26px; }
  .nav-right .login { font-size: 0.9rem; color: rgba(237,239,234,0.85); font-weight: 500; transition: color 0.15s; }
  .nav-right .login:hover { color: var(--turquesa); }
  .nav-right .btn-primary { 
    border-radius: 999px; 
    padding: var(--space-sm) var(--space-xl); 
    font-size: 0.9rem; 
    font-weight: 600; 
    background: var(--turquesa); 
    color: #0e2030; 
    border: none; 
    transition: background 0.15s; 
    display: inline-flex; 
    align-items: center; 
    justify-content: center; 
  }
  .nav-right .btn-primary:hover { background: #1ddccb; }

  /* Sticky nav once user scrolls past hero */
  :global(body.scrolled) header.nav { 
    position: fixed; 
    background: rgba(36, 51, 69, 0.78); 
    backdrop-filter: blur(16px) saturate(140%); 
    -webkit-backdrop-filter: blur(16px) saturate(140%); 
    border-bottom-color: rgba(255,255,255,0.06); 
  }
  :global(body.scrolled) header.nav .nav-inner { height: 64px; }


  /* === HAMBURGER (Mobile Only) === */
  .header-hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    width: 28px;
    padding: 4px 0;
  }

  .hamburger-line {
    display: block;
    width: 100%;
    height: 2px;
    background: #fff;
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .hamburger-active .hamburger-line:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }
  .hamburger-active .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  .hamburger-active .hamburger-line:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  /* === MOBILE MENU === */
  .header-mobile-menu {
    position: fixed;
    top: 60px; /* Adjust according to scrolled height */
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--ardosia);
    padding: var(--space-2xl);
    opacity: 0;
    transform: translateY(-10px);
    transition: all 0.3s ease;
    z-index: 999;
  }

  .header-mobile-menu.mobile-menu-open {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin-bottom: var(--space-md);
  }

  .mobile-link {
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--text-on-dark);
    display: block;
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--glass-dark-border);
  }

  .mobile-login {
    display: block;
    color: var(--text-on-dark-secondary);
    font-size: 1rem;
    font-weight: 500;
    padding: var(--space-md) 0;
  }

  .mobile-cta {
    width: 100%;
    margin-top: var(--space-md);
    text-align: center;
    border-radius: var(--radius-md);
    padding: var(--space-md) var(--space-xl);
    font-size: 0.95rem;
    font-weight: 600;
    background: var(--turquesa);
    color: #0e2030;
    border: none;
  }

  /* MEDIA QUERIES */
  @media (max-width: 900px) {
    .nav-links { display: none; }
    .nav-right .btn-primary { display: none; }
    .nav-right .login { display: none; }
    .header-hamburger { display: flex; }
  }
</style>
