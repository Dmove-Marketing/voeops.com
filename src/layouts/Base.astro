---
// src/layouts/Base.astro
import '../styles/global.css';
import GTMHead from '../components/tracking/GTMHead.astro';
import GTMBody from '../components/tracking/GTMBody.astro';
import UTMCapture from '../components/tracking/UTMCapture.astro';
import ParticleNetwork from '../components/ui/ParticleNetwork.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noIndex?: boolean;
  jsonLd?: Record<string, any>;
}

const {
  title,
  description = 'Vendas, Marketing, WhatsApp e IA em um só lugar. CRM brasileiro com WhatsApp nativo, automações e inteligência artificial.',
  ogImage = '/images/og-voe.jpg',
  canonical,
  noIndex = false,
  jsonLd,
} = Astro.props;

import config from '../../config.json';
const gtmId = config.tracking?.gtm_id || '';
const trackingEnabled = config.tracking?.enabled !== false;

const defaultJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description: description,
  url: canonical || Astro.url.href,
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />

    <link rel="icon" type="image/svg+xml" href="/images/icone-favicon.svg" />

    <!-- Preconnect para widget externo (economiza ~320ms no LCP) -->
    <link rel="preconnect" href="https://widget.voeops.com" />

    <!-- Preload da imagem LCP -->
    <link rel="preload" as="image" href="/images/tabs/tab-conversas.webp" />

    <!-- Preload critical fonts -->
    <link rel="preload" href="/fonts/geist-latin-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-latin-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-latin-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-latin-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-mono-latin-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif-latin-400-italic.woff2" as="font" type="font/woff2" crossorigin />

    {trackingEnabled && gtmId && <GTMHead gtmId={gtmId} />}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd || defaultJsonLd)} />

    <slot name="head" />
  </head>
  <body>
    {trackingEnabled && gtmId && <GTMBody gtmId={gtmId} />}
    {trackingEnabled && <UTMCapture />}

    <ParticleNetwork />

    <slot />

    <slot name="scripts" />

    <!-- Voe widget -->
    <script src="https://widget.voeops.com/w.js" data-voe="2e36936a3863509a24940c09cf14f760" async></script>

    <script>
      (function () {
        var launcher = null;
        var widgetOpen = false;
        var skipToggle = false;
        var pendingOpen = false;

        function findFab() {
          var host = document.getElementById('voe-widget-host');
          if (host && host.shadowRoot) {
            return host.shadowRoot.querySelector('.fab');
          }
          return null;
        }

        function attachLauncherListener(el) {
          if (el._voeListenerAttached) return;
          el._voeListenerAttached = true;
          el.addEventListener('click', function () {
            if (skipToggle) { skipToggle = false; return; }
            widgetOpen = !widgetOpen;
          });
        }

        // Faz polling até o botão .fab aparecer na shadow root
        function waitForLauncher(callback) {
          var el = findFab();
          if (el) { callback(el); return; }
          var attempts = 0;
          var t = setInterval(function () {
            el = findFab();
            attempts++;
            if (el) { clearInterval(t); callback(el); }
            else if (attempts > 100) { clearInterval(t); } // timeout 15s
          }, 150);
        }

        // Inicia a busca pelo botão assim que a página carrega
        waitForLauncher(function (el) {
          launcher = el;
          attachLauncherListener(launcher);
          if (pendingOpen && !widgetOpen) {
            pendingOpen = false;
            widgetOpen = true;
            skipToggle = true;
            launcher.click();
          }
        });

        // Reseta o estado quando o widget é fechado pelo botão interno do chat
        window.addEventListener('message', function (e) {
          if (e.data && e.data.type === 'voe-close') {
            widgetOpen = false;
          }
        });

        var hasScrolled = false;

        // Abre o widget automaticamente após 4 segundos
        setTimeout(function () {
          if (!hasScrolled) openWidget();
        }, 4000);

        function pulseFloat() {
          var float = document.querySelector('.whatsapp-float');
          if (!float) return;
          var s = float.style;
          s.transition = 'transform 0.13s ease-out';
          s.transform = 'scale(1.28)';
          setTimeout(function () {
            s.transform = 'scale(0.88)';
            setTimeout(function () {
              s.transform = 'scale(1.12)';
              setTimeout(function () {
                s.transform = 'scale(1)';
                setTimeout(function () { s.transform = ''; s.transition = ''; }, 130);
              }, 110);
            }, 110);
          }, 110);
        }

        function openWidget() {
          hasScrolled = true;
          if (!launcher) launcher = findFab();
          if (launcher) {
            if (widgetOpen) { pulseFloat(); return; }
            widgetOpen = true;
            skipToggle = true;
            launcher.click();
            return;
          }
          // Widget ainda carregando — agenda abertura para quando estiver pronto
          pendingOpen = true;
        }

        window.addEventListener('scroll', function () {
          if (hasScrolled) return;
          if (window.scrollY > 150) {
            hasScrolled = true;
            openWidget();
          }
        }, { passive: true });


        document.addEventListener('click', function (e) {
          var el = e.target.closest('a[href*="wa.me"]');
          if (!el || el.classList.contains('whatsapp-float')) return;
          e.preventDefault();
          openWidget();
        }, true);
      })();
    </script>
  </body>
</html>
