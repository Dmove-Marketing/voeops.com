---
// src/layouts/Base.astro
import '../styles/global.css';
import GTMHead from '../components/tracking/GTMHead.astro';
import GTMBody from '../components/tracking/GTMBody.astro';
import UTMCapture from '../components/tracking/UTMCapture.astro';
import ParticleNetwork from '../components/ui/ParticleNetwork.astro';
import CookieConsent from '../components/ui/CookieConsent.astro';
import SupportStatusWidget from '../components/ui/SupportStatusWidget.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noIndex?: boolean;
  jsonLd?: Record<string, any>;
}

const {
  title,
  description = 'Vendas, Marketing, WhatsApp e IA em um só lugar. CRM brasileiro com WhatsApp nativo, automações e inteligência artificial.',
  ogImage = '/images/og-voe.jpg',
  canonical,
  noIndex = false,
  jsonLd,
} = Astro.props;

import config from '../../config.json';
const gtmId = config.tracking?.gtm_id || '';
const trackingEnabled = config.tracking?.enabled !== false;

const defaultJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description: description,
  url: canonical || Astro.url.href,
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />

    <link rel="icon" type="image/svg+xml" href="/images/icone-favicon.svg" />

    <!-- Preconnect para widget externo (economiza ~320ms no LCP) -->
    <link rel="preconnect" href="https://widget.voeops.com" />

    <!-- Preload da imagem LCP -->
    <link rel="preload" as="image" href="/images/tabs/tab-conversas.webp" />

    <!-- Preload critical fonts -->
    <link rel="preload" href="/fonts/geist-latin-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-latin-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-latin-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-latin-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-mono-latin-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif-latin-400-italic.woff2" as="font" type="font/woff2" crossorigin />

    {trackingEnabled && gtmId && <GTMHead gtmId={gtmId} />}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd || defaultJsonLd)} />

    <slot name="head" />
  </head>
  <body>
    {trackingEnabled && gtmId && <GTMBody gtmId={gtmId} />}
    {trackingEnabled && <UTMCapture />}

    <ParticleNetwork />

    <slot />

    <slot name="scripts" />

    <!-- Aviso de cookies (LGPD) — aponta para a Política de Privacidade -->
    <CookieConsent learnMoreUrl="https://voeops.com/politica-de-privacidade/" learnMoreText="Política de Privacidade" />

    <!-- Acompanhamento do chamado sem login — só aparece pra quem já abriu um -->
    <SupportStatusWidget />

    <!-- Voe widget -->
    <script src="https://widget.voeops.com/w.js" data-voe="2e36936a3863509a24940c09cf14f760" async></script>

    <script>
      (function () {
        var launcher = null;
        var widgetOpen = false;
        var skipToggle = false;
        var pendingOpen = false;

        function findFab() {
          var host = document.getElementById('voe-widget-host');
          if (host && host.shadowRoot) {
            return host.shadowRoot.querySelector('.fab');
          }
          return null;
        }

        // Achado empírico: clicar de novo no .fab NÃO fecha o popup do
        // widget de vendas (o script dele só trata o clique como "abrir";
        // fechar de verdade só acontece pelo X de dentro do iframe, via
        // postMessage "voe-close"). Por isso, para fechar o popup de FORA
        // (quando o Suporte abre), a única forma confiável é esconder o
        // iframe na marra — ver window.__voeSalesHiddenBySupport, também
        // respeitado pelo script de responsividade mobile logo abaixo.
        function findWidgetIframe() {
          var list = document.getElementsByTagName('iframe');
          for (var i = 0; i < list.length; i++) {
            var f = list[i];
            var t = f.getAttribute('title') || '';
            var s = f.getAttribute('src') || '';
            if (t.indexOf('Falar com') === 0 || s.indexOf('voeops.com/embed') !== -1) return f;
          }
          return null;
        }

        function hideSalesWidget() {
          var f = findWidgetIframe();
          if (f) f.style.setProperty('display', 'none', 'important');
          window.__voeSalesHiddenBySupport = true;
        }

        function unhideSalesWidget() {
          window.__voeSalesHiddenBySupport = false;
          var f = findWidgetIframe();
          if (f) f.style.removeProperty('display');
        }

        function attachLauncherListener(el) {
          if (el._voeListenerAttached) return;
          el._voeListenerAttached = true;
          el.addEventListener('click', function () {
            if (skipToggle) { skipToggle = false; return; }
            widgetOpen = !widgetOpen;
            if (widgetOpen) {
              unhideSalesWidget();
              window.dispatchEvent(new CustomEvent('voe:sales-widget-open'));
            }
          });
        }

        // Faz polling até o botão .fab aparecer na shadow root
        function waitForLauncher(callback) {
          var el = findFab();
          if (el) { callback(el); return; }
          var attempts = 0;
          var t = setInterval(function () {
            el = findFab();
            attempts++;
            if (el) { clearInterval(t); callback(el); }
            else if (attempts > 100) { clearInterval(t); } // timeout 15s
          }, 150);
        }

        // Inicia a busca pelo botão assim que a página carrega
        waitForLauncher(function (el) {
          launcher = el;
          attachLauncherListener(launcher);

          // Mantém só o ícone: o balão de prévia do widget cobre o conteúdo
          var hideBubble = document.createElement('style');
          hideBubble.textContent = '.bubble{display:none!important}';
          el.getRootNode().appendChild(hideBubble);

          if (pendingOpen && !widgetOpen) {
            pendingOpen = false;
            widgetOpen = true;
            skipToggle = true;
            launcher.click();
            unhideSalesWidget();
            window.dispatchEvent(new CustomEvent('voe:sales-widget-open'));
          }
        });

        // Reseta o estado quando o widget é fechado pelo botão interno do chat
        window.addEventListener('message', function (e) {
          if (e.data && e.data.type === 'voe-close') {
            widgetOpen = false;
          }
        });

        var hasScrolled = false;

        // Abertura automática (4s e scroll) acontece SOMENTE na página inicial.
        // Nas demais páginas o widget só abre quando o usuário clica no botão.
        var isHome = window.location.pathname === '/';

        // Abre o widget automaticamente após 4 segundos (somente na home)
        if (isHome) {
          setTimeout(function () {
            if (!hasScrolled) openWidget();
          }, 4000);
        }

        // Shake no botão do widget (canto superior direito) quando já está aberto
        function shakeFloat() {
          if (!launcher) return;
          var moves = ['-5px', '5px', '-4px', '4px', '-2px', '0px'];
          var i = 0;
          launcher.style.transition = 'transform 0.07s ease-out';
          function step() {
            if (i >= moves.length) {
              launcher.style.transform = '';
              launcher.style.transition = '';
              return;
            }
            launcher.style.transform = 'translateX(' + moves[i++] + ')';
            setTimeout(step, 70);
          }
          step();
        }

        function openWidget(triggerEl) {
          hasScrolled = true;
          if (!launcher) launcher = findFab();
          if (launcher) {
            if (widgetOpen) {
              shakeFloat();
              return;
            }
            widgetOpen = true;
            skipToggle = true;
            launcher.click();
            unhideSalesWidget();
            window.dispatchEvent(new CustomEvent('voe:sales-widget-open'));
            return;
          }
          // Widget ainda carregando — agenda abertura para quando estiver pronto
          pendingOpen = true;
        }

        // Um widget não pode ficar aberto em cima do outro: quando o de
        // suporte abre (SupportStatusWidget), fecha o de vendas se estiver
        // aberto. launcher.click() sozinho não fecha o popup de vendas (ver
        // nota em findWidgetIframe) — por isso escondemos o iframe na marra.
        window.addEventListener('voe:support-widget-open', function () {
          if (!launcher) launcher = findFab();
          if (widgetOpen) {
            widgetOpen = false;
            if (launcher) { skipToggle = true; launcher.click(); }
          }
          hideSalesWidget();
        });

        // Abre ao rolar a página > 150px (somente na home)
        if (isHome) {
          window.addEventListener('scroll', function () {
            if (hasScrolled) return;
            if (window.scrollY > 150) {
              hasScrolled = true;
              openWidget();
            }
          }, { passive: true });
        }


        document.addEventListener('click', function (e) {
          var el = e.target.closest('a[href*="wa.me"]');
          if (!el || el.classList.contains('whatsapp-float')) return;
          e.preventDefault();
          openWidget(el);
        }, true);
      })();
    </script>

    <!-- Responsividade do popup do widget no mobile.
         O widget (widget.voeops.com/w.js) injeta um <iframe> no <body> com
         largura/altura FIXAS de desktop (320x520) via style inline. No celular
         isso estoura a viewport. Em vez de depender de CSS (que perde a corrida
         de especificidade/dvh contra o estilo inline do script externo), aqui
         forçamos as dimensões direto no elemento, recalculando a partir do
         viewport real (visualViewport) e reaplicando em resize/rotação. -->
    <script>
      (function () {
        var BP = 768; // breakpoint mobile

        // Identifica o iframe do widget (light DOM, fora da shadow root do FAB).
        // Casa pelo título ("Falar com ...") ou pelo src do /embed do widget,
        // evitando iframes de YouTube/Vimeo/GTM.
        function isWidgetIframe(f) {
          if (!f || f.tagName !== 'IFRAME') return false;
          var t = f.getAttribute('title') || '';
          var s = f.getAttribute('src') || '';
          if (t.indexOf('Falar com') === 0) return true;
          if (s.indexOf('voeops.com/embed') !== -1) return true;
          if (s.indexOf('/embed/') !== -1 &&
              s.indexOf('youtube') === -1 && s.indexOf('youtu.be') === -1 &&
              s.indexOf('vimeo') === -1 && s.indexOf('googletagmanager') === -1) return true;
          return false;
        }

        function applySize(f) {
          if (!isWidgetIframe(f)) return;
          // Guarda o style original uma única vez para restaurar no desktop.
          if (f.getAttribute('data-voe-orig-style') === null) {
            f.setAttribute('data-voe-orig-style', f.getAttribute('style') || '');
          }
          if (window.innerWidth <= BP) {
            var vw = window.innerWidth;
            var vh = (window.visualViewport && window.visualViewport.height) || window.innerHeight;
            var bottom = 84; // espaço para o botão flutuante
            // Popup COMPACTO no mobile: pequeno, ancorado no canto inferior
            // direito, sem cobrir a tela toda — o resto do site continua visível.
            var w = Math.min(vw - 32, 300);
            var h = Math.min(Math.round(vh * 0.6), 440);
            if (h < 320) h = Math.min(vh - bottom - 12, 320); // garante mínimo usável, mas nunca estoura
            f.style.setProperty('position', 'fixed', 'important');
            f.style.setProperty('width', w + 'px', 'important');
            f.style.setProperty('max-width', 'none', 'important');
            f.style.setProperty('height', h + 'px', 'important');
            f.style.setProperty('max-height', 'none', 'important');
            f.style.setProperty('left', 'auto', 'important');
            f.style.setProperty('right', '16px', 'important');
            f.style.setProperty('top', 'auto', 'important');
            f.style.setProperty('bottom', bottom + 'px', 'important');
            f.style.setProperty('border-radius', '14px', 'important');
          } else {
            // Desktop: restaura exatamente o style original do widget.
            f.setAttribute('style', f.getAttribute('data-voe-orig-style') || '');
            // Não desfaz o "escondido na marra" pedido pelo Suporte (ver
            // Base.astro/hideSalesWidget) — um resize no meio do caminho não
            // pode trazer o popup de vendas de volta por cima do Suporte.
            if (window.__voeSalesHiddenBySupport) {
              f.style.setProperty('display', 'none', 'important');
            }
          }
        }

        function applyAll() {
          var list = document.getElementsByTagName('iframe');
          for (var i = 0; i < list.length; i++) applySize(list[i]);
        }

        // O iframe é criado de forma assíncrona pelo script do widget — observa o
        // DOM para pegá-lo assim que aparecer (e quando reabre).
        var mo = new MutationObserver(function (muts) {
          for (var m = 0; m < muts.length; m++) {
            var added = muts[m].addedNodes;
            for (var n = 0; n < added.length; n++) {
              var node = added[n];
              if (!node || node.nodeType !== 1) continue;
              if (node.tagName === 'IFRAME') applySize(node);
              else if (node.getElementsByTagName) {
                var inner = node.getElementsByTagName('iframe');
                for (var k = 0; k < inner.length; k++) applySize(inner[k]);
              }
            }
          }
        });
        if (document.body) mo.observe(document.body, { childList: true, subtree: true });

        applyAll();
        window.addEventListener('resize', applyAll);
        window.addEventListener('orientationchange', applyAll);
        if (window.visualViewport) window.visualViewport.addEventListener('resize', applyAll);
      })();
    </script>
  </body>
</html>
