---
// src/layouts/Base.astro
import '../styles/global.css';
import GTMHead from '../components/tracking/GTMHead.astro';
import GTMBody from '../components/tracking/GTMBody.astro';
import UTMCapture from '../components/tracking/UTMCapture.astro';
import ParticleNetwork from '../components/ui/ParticleNetwork.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noIndex?: boolean;
  jsonLd?: Record<string, any>;
}

const {
  title,
  description = 'Vendas, Marketing, WhatsApp e IA em um só lugar. CRM brasileiro com WhatsApp nativo, automações e inteligência artificial.',
  ogImage = '/images/og-voe.jpg',
  canonical,
  noIndex = false,
  jsonLd,
} = Astro.props;

import config from '../../config.json';
const gtmId = config.tracking?.gtm_id || '';
const trackingEnabled = config.tracking?.enabled !== false;

const defaultJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description: description,
  url: canonical || Astro.url.href,
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />

    <link rel="icon" type="image/svg+xml" href="/images/icone-favicon.svg" />

    <!-- Preconnect para widget externo (economiza ~320ms no LCP) -->
    <link rel="preconnect" href="https://widget.voeops.com" />

    <!-- Preload da imagem LCP -->
    <link rel="preload" as="image" href="/images/tabs/tab-conversas.webp" />

    <!-- Preload critical fonts -->
    <link rel="preload" href="/fonts/geist-latin-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-latin-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-latin-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-latin-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-mono-latin-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif-latin-400-italic.woff2" as="font" type="font/woff2" crossorigin />

    {trackingEnabled && gtmId && <GTMHead gtmId={gtmId} />}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd || defaultJsonLd)} />

    <slot name="head" />
  </head>
  <body>
    {trackingEnabled && gtmId && <GTMBody gtmId={gtmId} />}
    {trackingEnabled && <UTMCapture />}

    <ParticleNetwork />

    <slot />

    <slot name="scripts" />

    <!-- Voe widget -->
    <script src="https://widget.voeops.com/w.js" data-voe="2e36936a3863509a24940c09cf14f760" async></script>

    <script>
      (function () {
        var launcher = null;

        // Observa o DOM até o botão do widget aparecer
        function findLauncher() {
          return (
            document.querySelector('button[id*="voe"]') ||
            document.querySelector('button[class*="voe"]') ||
            document.querySelector('[data-voe-launcher]') ||
            document.querySelector('iframe[src*="widget.voeops"]')
          );
        }

        var mo = new MutationObserver(function () {
          var el = findLauncher();
          if (el) { launcher = el; mo.disconnect(); }
        });

        function startObserver() {
          mo.observe(document.body, { childList: true, subtree: true });
        }

        if (document.body) {
          startObserver();
        } else {
          document.addEventListener('DOMContentLoaded', startObserver);
        }

        function openWidget() {
          if (!launcher) launcher = findLauncher();
          if (launcher) { launcher.click(); return; }
          // fallback se o widget ainda não carregou
          window.open('https://wa.me/5511999803580', '_blank', 'noopener,noreferrer');
        }

        // Captura cliques em todos os links wa.me (CTAs, float, footer)
        document.addEventListener('click', function (e) {
          var el = e.target.closest('a[href*="wa.me"]');
          if (!el) return;
          e.preventDefault();
          openWidget();
        }, true);
      })();
    </script>
  </body>
</html>
